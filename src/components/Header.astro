---
// src/components/Header.astro
const nav = [
    { label: "Sobre mí", href: "#sobre-mi" },
    { label: "GitHub", href: "#github" },
    { label: "Proyectos", href: "#proyectos" },
    { label: "Stack", href: "#stack" },
    { label: "Experiencia", href: "#experiencia" },
    { label: "Contacto", href: "#contacto" },
];

const primaryLabels = ["Proyectos", "Experiencia", "Contacto"];
const primaryNav = nav.filter((item) => primaryLabels.includes(item.label));
---

<header
    class="fixed top-0 w-full z-50 bg-light-bg/80 dark:bg-dark-bg/80 backdrop-blur-md border-b border-light-neutral/20 dark:border-dark-neutral/50 transition-colors duration-300"
>
    <div class="mx-full flex max-w-full items-center justify-between px-6 py-4">
        <a
            href="/"
            class="flex items-center gap-2 font-heading font-semibold tracking-tight text-light-secondary dark:text-white"
        >
            <img
                src="my.png"
                alt="Lukas Garrido"
                class="h-6 w-6 rounded-full ring-1 ring-slate-200"
            />Lukas Garrido
        </a>

        <nav
            class="hidden items-center gap-8 text-sm text-light-neutral dark:text-gray-400 md:flex"
        >
            {
                primaryNav.map((item) => (
                    <a
                        href={item.href}
                        class="transition-colors hover:text-light-primary dark:hover:text-white"
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-2">
            <div class="relative">
                <button
                    id="nav-menu-toggle"
                    class="flex items-center justify-center rounded-full bg-light-neutral/10 dark:bg-dark-neutral/50 p-2.5 text-light-secondary dark:text-white hover:bg-light-neutral/20 dark:hover:bg-dark-neutral transition-colors"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="nav-menu"
                    aria-label="Abrir menú de navegación"
                >
                    <svg
                        id="nav-menu-icon-open"
                        class="h-5 w-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    <svg
                        id="nav-menu-icon-close"
                        class="hidden h-5 w-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>

                <div
                    id="nav-menu"
                    class="hidden absolute right-0 mt-2 w-52 overflow-hidden rounded-xl border border-light-neutral/20 dark:border-dark-neutral bg-light-bg dark:bg-dark-bg shadow-lg"
                >
                    {
                        nav.map((item) => (
                            <a
                                href={item.href}
                                class="block px-4 py-2.5 text-sm text-light-secondary dark:text-gray-300 hover:bg-light-neutral/10 dark:hover:bg-dark-neutral/50 transition-colors"
                                data-nav-link
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </div>
            </div>

            <button
                id="theme-toggle"
                class="p-2 rounded-full bg-light-neutral/10 dark:bg-dark-neutral/50 hover:bg-light-neutral/20 dark:hover:bg-dark-neutral transition-colors"
                aria-label="Cambiar tema"
            >
                <svg
                    id="theme-toggle-light-icon"
                    class="hidden w-5 h-5 text-yellow-500"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                        fill-rule="evenodd"
                        clip-rule="evenodd"></path>
                </svg>
                <svg
                    id="theme-toggle-dark-icon"
                    class="hidden w-5 h-5 text-light-secondary dark:text-dark-secondary"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                    ></path>
                </svg>
            </button>
        </div>
    </div>
</header>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const themeToggleBtn = document.getElementById("theme-toggle");
        const darkIcon = document.getElementById("theme-toggle-dark-icon");
        const lightIcon = document.getElementById("theme-toggle-light-icon");

        if (!themeToggleBtn) return;

        const updateIcon = () => {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                darkIcon.classList.add("hidden");
                lightIcon.classList.remove("hidden");
            } else {
                lightIcon.classList.add("hidden");
                darkIcon.classList.remove("hidden");
            }
        };

        updateIcon();

        themeToggleBtn.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark");
            const isDark = document.documentElement.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
            updateIcon();
        });
    });
</script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const menuToggleBtn = document.getElementById("nav-menu-toggle");
        const menu = document.getElementById("nav-menu");
        const openIcon = document.getElementById("nav-menu-icon-open");
        const closeIcon = document.getElementById("nav-menu-icon-close");

        if (!menuToggleBtn || !menu) return;

        const closeMenu = () => {
            menu.classList.add("hidden");
            openIcon.classList.remove("hidden");
            closeIcon.classList.add("hidden");
            menuToggleBtn.setAttribute("aria-expanded", "false");
        };

        const openMenu = () => {
            menu.classList.remove("hidden");
            openIcon.classList.add("hidden");
            closeIcon.classList.remove("hidden");
            menuToggleBtn.setAttribute("aria-expanded", "true");
        };

        menuToggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen =
                menuToggleBtn.getAttribute("aria-expanded") === "true";
            isOpen ? closeMenu() : openMenu();
        });

        document.querySelectorAll("[data-nav-link]").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        document.addEventListener("click", (e) => {
            if (!menu.contains(e.target) && !menuToggleBtn.contains(e.target)) {
                closeMenu();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeMenu();
        });
    });
</script>
