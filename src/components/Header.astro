---
// src/components/Header.astro
---

<header
    class="fixed top-0 w-full z-50 bg-light-bg/80 dark:bg-dark-bg/80 backdrop-blur-md border-b border-light-neutral/20 dark:border-dark-neutral/50 transition-colors duration-300"
>
    <div
        class="max-full-6xl mx-auto px-6 h-16 flex items-center justify-between"
    >
        <a
            href="/"
            class="font-heading text-xl font-bold flex items-center gap-2 hover:opacity-80 transition-opacity"
        >
            <svg
                class="w-6 h-6 text-light-primary dark:text-dark-primary"
                fill="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                ></path>
            </svg>
            <span class="text-light-neutral dark:text-gray-400 dark:text-white"
                >tu_marca</span
            >
        </a>

        <nav class="hidden md:flex items-center gap-8">
            <a
                href="#general"
                class="text-sm font-medium text-light-neutral dark:text-gray-400 hover:text-light-primary dark:hover:text-white transition-colors"
                >General</a
            >
            <a
                href="#proyectos"
                class="text-sm font-medium text-light-neutral dark:text-gray-400 hover:text-light-primary dark:hover:text-white transition-colors"
                >Proyectos</a
            >
            <a
                href="#stack"
                class="text-sm font-medium text-light-neutral dark:text-gray-400 hover:text-light-primary dark:hover:text-white transition-colors"
                >Stack</a
            >
            <a
                href="#experiencia"
                class="text-sm font-medium text-light-neutral dark:text-gray-400 hover:text-light-primary dark:hover:text-white transition-colors"
                >Experiencia</a
            >
            <a
                href="#contacto"
                class="text-sm font-medium text-light-neutral dark:text-gray-400 hover:text-light-primary dark:hover:text-white transition-colors"
                >Contacto</a
            >
        </nav>

        <div class="flex items-center gap-4">
            <div
                class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-light-tertiary/10 dark:bg-dark-tertiary/10 border border-light-tertiary/20 dark:border-dark-tertiary/20"
            >
                <span class="relative flex h-2 w-2">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-light-tertiary dark:bg-dark-tertiary opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-light-tertiary dark:bg-dark-tertiary"
                    ></span>
                </span>
                <span
                    class="text-xs font-semibold text-light-neutral dark:text-gray-400 dark:text-dark-tertiary tracking-wide"
                >
                    DISPONIBLE PARA TRABAJO
                </span>
            </div>

            <button
                id="theme-toggle"
                class="p-2 rounded-full bg-light-neutral/10 dark:bg-dark-neutral/50 hover:bg-light-neutral/20 dark:hover:bg-dark-neutral transition-colors"
                aria-label="Cambiar tema"
            >
                <svg
                    id="theme-toggle-light-icon"
                    class="hidden w-5 h-5 text-yellow-500"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                        fill-rule="evenodd"
                        clip-rule="evenodd"></path>
                </svg>
                <svg
                    id="theme-toggle-dark-icon"
                    class="hidden w-5 h-5 text-light-secondary dark:text-dark-secondary"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                    ></path>
                </svg>
            </button>
        </div>
    </div>
</header>

<script is:inline>
    // En Astro, este script al final del componente ya tiene acceso a los elementos del DOM.
    // Usamos una función autoejecutable o simplemente código directo.
    (() => {
        const themeToggleBtn = document.getElementById("theme-toggle");
        const darkIcon = document.getElementById("theme-toggle-dark-icon");
        const lightIcon = document.getElementById("theme-toggle-light-icon");

        if (!themeToggleBtn || !darkIcon || !lightIcon) {
            console.error("Faltan elementos del toggle de tema.");
            return;
        }

        const updateIcon = () => {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                darkIcon.classList.add("hidden");
                lightIcon.classList.remove("hidden");
            } else {
                lightIcon.classList.add("hidden");
                darkIcon.classList.remove("hidden");
            }
        };

        updateIcon();

        themeToggleBtn.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark");
            const isDark = document.documentElement.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
            updateIcon();
        });
    })();
</script>
