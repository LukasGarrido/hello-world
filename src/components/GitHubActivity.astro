---
// src/components/GitHubActivity.astro
interface Props {
    username: string;
}

const { username } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-12">
    <!-- Encabezado con botón de perfil a la derecha -->
    <div
        class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end mb-8"
    >
        <div>
            <p
                class="text-xs font-medium uppercase tracking-wide text-light-primary dark:text-dark-primary"
            >
                ACTIVIDAD EN GITHUB
            </p>
            <h2
                class="mt-2 text-2xl font-bold tracking-tight text-light-secondary dark:text-white sm:text-3xl font-heading"
            >
                @{username}
            </h2>
            <p class="mt-1 text-sm text-light-neutral dark:text-gray-400">
                Contribuciones, repos destacados y commits recientes.
            </p>
        </div>
        <a
            href={`https://github.com/${username}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-light-neutral/20 dark:border-dark-neutral bg-light-surface dark:bg-dark-surface px-4 py-2.5 text-xs font-medium text-light-secondary dark:text-white transition-colors hover:bg-light-neutral/10 dark:hover:bg-dark-neutral/50 self-start sm:self-auto"
        >
            Ver perfil
            <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
            </svg>
        </a>
    </div>

    <!-- Contenedor General estilo Card de GitHub -->
    <div
        class="rounded-3xl border border-light-neutral/20 dark:border-dark-neutral bg-light-surface dark:bg-dark-surface p-6 sm:p-8 shadow-sm"
    >
        <!-- Fila Superior: Mapa de calor / gráfico e indicador de commits recientes -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
            <!-- Gráfico de Contribuciones (Ocupa 2 columnas) -->
            <div class="lg:col-span-2 overflow-x-auto py-2">
                <div
                    class="flex items-center justify-between mb-3 text-xs text-light-neutral dark:text-gray-400"
                >
                    <span>Contribuciones · último año</span>
                </div>
                <img
                    src={`https://github-readme-activity-graph.vercel.app/graph?username=${username}&theme=react-dark&hide_border=true&color=6366F1&line=6366F1&point=06B6D4&background=111315`}
                    alt="Gráfico de actividad de GitHub"
                    class="w-full h-auto min-w-[450px] rounded-xl"
                />
            </div>

            <!-- Panel Lateral: Commits Recientes / Actividad -->
            <div class="flex flex-col gap-3">
                <span
                    class="text-xs font-semibold uppercase tracking-wider text-light-neutral dark:text-gray-400"
                >
                    COMMITS RECIENTES
                </span>
                <div
                    class="rounded-2xl border border-light-neutral/10 dark:border-dark-neutral/80 bg-light-bg dark:bg-dark-bg p-4 transition-colors"
                >
                    <div class="flex items-center justify-between mb-1">
                        <p
                            class="text-xs font-semibold text-light-secondary dark:text-white"
                        >
                            Push al repositorio
                        </p>
                    </div>
                    <p
                        class="text-[11px] text-light-neutral dark:text-gray-400 flex items-center gap-1 mt-2"
                    >
                        <svg
                            class="w-3 h-3 text-light-primary dark:text-dark-primary"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                            ></path></svg
                        >
                        {username} · Actividad reciente
                    </p>
                </div>
            </div>
        </div>

        <!-- Fila Inferior: Estadísticas Rápidas en Mini-Cards -->
        <div
            class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-light-neutral/10 dark:border-dark-neutral/50"
        >
            <div
                class="rounded-2xl border border-light-neutral/10 dark:border-dark-neutral/80 bg-light-bg dark:bg-dark-bg p-4"
            >
                <p
                    class="text-2xl font-bold text-light-secondary dark:text-white"
                >
                    376
                </p>
                <p class="text-xs text-light-neutral dark:text-gray-400 mt-1">
                    Contribuciones
                </p>
            </div>
            <div
                class="rounded-2xl border border-light-neutral/10 dark:border-dark-neutral/80 bg-light-bg dark:bg-dark-bg p-4"
            >
                <p
                    class="text-2xl font-bold text-light-secondary dark:text-white"
                >
                    20
                </p>
                <p class="text-xs text-light-neutral dark:text-gray-400 mt-1">
                    Repos públicos
                </p>
            </div>
            <div
                class="rounded-2xl border border-light-neutral/10 dark:border-dark-neutral/80 bg-light-bg dark:bg-dark-bg p-4"
            >
                <p
                    class="text-2xl font-bold text-light-secondary dark:text-white"
                >
                    5
                </p>
                <p class="text-xs text-light-neutral dark:text-gray-400 mt-1">
                    Seguidores
                </p>
            </div>
        </div>
    </div>
</section>
