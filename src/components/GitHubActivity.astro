---
// src/components/GitHubActivity.astro
interface Props {
    username: string;
}

const { username } = Astro.props;

const token = import.meta.env.GITHUB_TOKEN;
const ghHeaders: HeadersInit = token
    ? { Authorization: `Bearer ${token}`, "User-Agent": username }
    : { "User-Agent": username };

const languageColors: Record<string, string> = {
    TypeScript: "#3178c6",
    JavaScript: "#f1e05a",
    Python: "#3572A5",
    HTML: "#e34c26",
    CSS: "#563d7c",
    Astro: "#ff5a03",
    Kotlin: "#A97BFF",
    Java: "#b07219",
    Go: "#00ADD8",
    Rust: "#dea584",
    "C++": "#f34b7d",
    "C#": "#178600",
    PHP: "#4F5D95",
    Ruby: "#701516",
    Shell: "#89e051",
    "Jupyter Notebook": "#DA5B0B",
    Vue: "#41b883",
    Dart: "#00B4AB",
};

function langColor(lang: string | null) {
    return lang ? (languageColors[lang] ?? "#8b8b8b") : "#8b8b8b";
}

function timeAgo(dateStr: string) {
    const diffMs = Date.now() - new Date(dateStr).getTime();
    const minutes = Math.floor(diffMs / 60000);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    const weeks = Math.floor(days / 7);
    const months = Math.floor(days / 30);

    if (minutes < 60) return `hace ${minutes} min.`;
    if (hours < 24) return `hace ${hours} h.`;
    if (days < 7) return `hace ${days} día${days === 1 ? "" : "s"}.`;
    if (weeks < 5) return `hace ${weeks} sem.`;
    return `hace ${months} mes${months === 1 ? "" : "es"}.`;
}

interface ContributionDay {
    date: string;
    count: number;
    level: number;
}

function buildWeeks(contributions: ContributionDay[]) {
    if (!contributions?.length) return [];
    const firstDay = new Date(`${contributions[0].date}T00:00:00Z`).getUTCDay();
    const padded: (ContributionDay | null)[] = [
        ...Array.from({ length: firstDay }, () => null),
        ...contributions,
    ];
    const weeks: (ContributionDay | null)[][] = [];
    for (let i = 0; i < padded.length; i += 7) {
        weeks.push(padded.slice(i, i + 7));
    }
    return weeks;
}

const levelColors = [
    "bg-slate-100",
    "bg-indigo-200",
    "bg-indigo-400",
    "bg-indigo-500",
    "bg-violet-600",
];

const [profileRes, reposRes, eventsRes, contribRes] = await Promise.allSettled([
    fetch(`https://api.github.com/users/${username}`, { headers: ghHeaders }),
    fetch(
        `https://api.github.com/users/${username}/repos?sort=pushed&per_page=100`,
        { headers: ghHeaders },
    ),
    fetch(`https://api.github.com/users/${username}/events/public`, {
        headers: ghHeaders,
    }),
    fetch(`https://github-contributions-api.jogruber.de/v4/${username}?y=last`),
]);

const profile =
    profileRes.status === "fulfilled" && profileRes.value.ok
        ? await profileRes.value.json()
        : null;

const allRepos =
    reposRes.status === "fulfilled" && reposRes.value.ok
        ? await reposRes.value.json()
        : [];

const featuredRepos = allRepos
    .filter((repo: any) => !repo.fork)
    .sort(
        (a: any, b: any) =>
            new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime(),
    )
    .slice(0, 4);

const events =
    eventsRes.status === "fulfilled" && eventsRes.value.ok
        ? await eventsRes.value.json()
        : [];

const lastPush = events.find((e: any) => e.type === "PushEvent");

const contribData =
    contribRes.status === "fulfilled" && contribRes.value.ok
        ? await contribRes.value.json()
        : null;

const contributions: ContributionDay[] = contribData?.contributions ?? [];
const weeks = buildWeeks(contributions);
const totalContributions =
    contribData?.total?.[String(new Date().getFullYear())] ??
    contributions.reduce((sum, day) => sum + day.count, 0);
---

<section class="mx-auto max-w-6xl px-6 py-12">
    <!-- Encabezado -->
    <div
        class="mb-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-end"
    >
        <div>
            <p
                class="text-xs font-medium uppercase tracking-wide text-indigo-600"
            >
                Actividad en GitHub
            </p>
            <h2 class="mt-1.5 text-xl font-bold tracking-tight text-slate-900">
                @{username}
            </h2>
            <p class="mt-1 text-sm text-slate-500">
                Contribuciones, repos destacados y commits recientes.
            </p>
        </div>

        <a
            href={`https://github.com/${username}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 self-start rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50 sm:self-auto"
        >
            Ver perfil
            <svg
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
            </svg>
        </a>
    </div>

    <!-- Card principal -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
        <!-- Heatmap + Commits recientes -->
        <div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-3">
            <div class="overflow-x-auto lg:col-span-2">
                <div
                    class="mb-2 flex items-center justify-between text-xs text-slate-500"
                >
                    <span>{totalContributions} contribuciones · último año</span
                    >
                    <div class="flex items-center gap-1">
                        <span>Menos</span>
                        {
                            levelColors.map((c) => (
                                <span class={`h-2.5 w-2.5 rounded-sm ${c}`} />
                            ))
                        }
                        <span>Más</span>
                    </div>
                </div>

                {
                    weeks.length > 0 ? (
                        <div class="flex gap-[2.5px]">
                            {weeks.map((week) => (
                                <div class="flex flex-col gap-[2.5px]">
                                    {week.map((day) =>
                                        day ? (
                                            <span
                                                class={`h-2.5 w-2.5 rounded-sm ${levelColors[day.level]}`}
                                                title={`${day.count} contribuciones el ${day.date}`}
                                            />
                                        ) : (
                                            <span class="h-2.5 w-2.5 rounded-sm bg-transparent" />
                                        ),
                                    )}
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p class="text-xs text-slate-400">
                            No se pudo cargar el mapa de contribuciones en este
                            momento.
                        </p>
                    )
                }
            </div>

            <!-- Panel commits recientes -->
            <div class="flex flex-col gap-2">
                <span
                    class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-slate-500"
                >
                    <svg
                        class="h-3.5 w-3.5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                        ></path>
                    </svg>
                    Commits recientes
                </span>

                {
                    lastPush ? (
                        <div class="rounded-xl bg-slate-50 p-3">
                            <p class="text-xs font-semibold text-slate-900">
                                Push al repositorio
                            </p>
                            <p class="mt-1.5 flex items-center gap-1 text-[11px] text-slate-500">
                                <svg
                                    class="h-3 w-3 text-indigo-600"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                </svg>
                                {username} · {timeAgo(lastPush.created_at)}
                            </p>
                        </div>
                    ) : (
                        <div class="rounded-xl bg-slate-50 p-3">
                            <p class="text-xs text-slate-400">
                                Sin actividad pública reciente.
                            </p>
                        </div>
                    )
                }
            </div>
        </div>

        <!-- Mini-cards de estadísticas -->
        <div class="mt-5 grid grid-cols-3 gap-3 border-t border-slate-100 pt-5">
            <div class="rounded-xl bg-slate-50 p-3">
                <p class="text-lg font-bold text-slate-900">
                    {totalContributions}
                </p>
                <p class="mt-0.5 text-[11px] text-slate-500">Contribuciones</p>
            </div>
            <div class="rounded-xl bg-slate-50 p-3">
                <p class="text-lg font-bold text-slate-900">
                    {profile?.public_repos ?? "—"}
                </p>
                <p class="mt-0.5 text-[11px] text-slate-500">Repos públicos</p>
            </div>
            <div class="rounded-xl bg-slate-50 p-3">
                <p class="text-lg font-bold text-slate-900">
                    {profile?.followers ?? "—"}
                </p>
                <p class="mt-0.5 text-[11px] text-slate-500">Seguidores</p>
            </div>
        </div>

        <!-- Repos destacados -->
        <div class="mt-5 border-t border-slate-100 pt-5">
            <p
                class="mb-3 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
                <svg
                    class="h-3.5 w-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M20 7h-9m3-3v6M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm0 10a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2z"
                    ></path>
                </svg>
                Repos destacados
            </p>

            {
                featuredRepos.length > 0 ? (
                    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                        {featuredRepos.map((repo: any) => (
                            <a
                                href={repo.html_url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex flex-col gap-1.5 rounded-xl bg-slate-50 p-3 transition-colors hover:bg-slate-100"
                            >
                                <div class="flex items-start justify-between gap-2">
                                    <p class="text-sm font-semibold text-slate-900">
                                        {repo.name}
                                    </p>
                                    {repo.stargazers_count > 0 && (
                                        <span class="flex shrink-0 items-center gap-1 text-xs font-medium text-amber-600">
                                            <svg
                                                class="h-3 w-3"
                                                fill="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                            </svg>
                                            {repo.stargazers_count}
                                        </span>
                                    )}
                                </div>
                                <p class="text-xs leading-relaxed text-slate-500">
                                    {repo.description ?? "Sin descripción."}
                                </p>
                                {repo.language && (
                                    <span class="mt-0.5 inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600">
                                        <span
                                            class="h-2 w-2 rounded-full"
                                            style={`background-color:${langColor(repo.language)}`}
                                        />
                                        {repo.language}
                                    </span>
                                )}
                            </a>
                        ))}
                    </div>
                ) : (
                    <p class="text-xs text-slate-400">
                        No se encontraron repositorios públicos.
                    </p>
                )
            }
        </div>
    </div>
</section>
