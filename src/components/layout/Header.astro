---
// src/components/layout/Header.astro
interface NavItem {
    label: string;
    href: string;
    icon: string; // contenido interno del <svg>
}

const navItems: readonly NavItem[] = [
    {
        label: "Inicio",
        href: "/#sobre-mi",
        icon: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
    },
    {
        label: "Proyectos",
        href: "/#proyectos",
        icon: `<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>`,
    },
    {
        label: "Experiencia",
        href: "/#experiencia",
        icon: `<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>`,
    },
    {
        label: "Stack",
        href: "/#stack",
        icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
    },
    {
        label: "Metodología",
        href: "/#metodologia",
        icon: `<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>`,
    },
    {
        label: "Formación",
        href: "/#formacion",
        icon: `<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>`,
    },
];
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
    <nav
        aria-label="Navegación principal"
        class="rounded-xl border border-border/60 bg-card/80 p-1.5 backdrop-blur-md"
    >
        <ul class="m-0 flex list-none items-center gap-1 p-0">
            {
                navItems.map((item) => (
                    <li class="group relative">
                        <a
                            href={item.href}
                            aria-label={item.label}
                            data-nav-link
                            data-target={item.href.split("#")[1]}
                            class="flex h-9 w-9 items-center justify-center rounded-lg text-foreground/70 transition-colors hover:bg-muted hover:text-foreground data-[active=true]:bg-muted data-[active=true]:text-foreground"
                        >
                            <svg
                                class="h-5 w-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.75"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                set:html={item.icon}
                            />
                        </a>

                        <span
                            role="tooltip"
                            class="pointer-events-none absolute left-1/2 top-full mt-2 -translate-x-1/2 -translate-y-1 whitespace-nowrap rounded-md bg-card px-2.5 py-1 text-xs font-medium text-foreground opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100"
                        >
                            {item.label}
                        </span>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<script>
    function setupActiveNav(): void {
        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
        );
        if (!links.length) return;

        const setActive = (id: string): void => {
            links.forEach((link) => {
                link.dataset.active = String(link.dataset.target === id);
            });
        };

        const sections = links
            .map((link) => document.getElementById(link.dataset.target ?? ""))
            .filter((el): el is HTMLElement => el !== null);

        // En páginas sin esas secciones (ej. detalle de proyecto) no hay nada que marcar
        if (!sections.length) return;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) setActive(entry.target.id);
                });
            },
            { rootMargin: "-40% 0px -55% 0px" },
        );

        sections.forEach((section) => observer.observe(section));
        setActive(sections[0].id);
    }

    document.addEventListener("astro:page-load", setupActiveNav);
    setupActiveNav();
</script>
