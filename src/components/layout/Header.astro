---
// src/components/layout/Header.astro
import Button from "../ui/Button.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";

const navLinks = [
    { label: "Proyectos", href: "#proyectos" },
    { label: "Experiencia", href: "#experiencia" },
    { label: "Formación", href: "#formacion" },
    { label: "GitHub", href: "#github" },
    { label: "Contacto", href: "#contacto" },
];
---

<header id="site-header" class="sticky top-0 z-50 w-full site-header">
    <div class="w-full flex items-center justify-between px-6 md:px-12 py-4">
        <a
            href="/"
            class="font-display text-base font-bold text-foreground no-underline hover:opacity-80 transition-opacity"
        >
            Lukas.Dev
        </a>

        <nav class="hidden md:block" aria-label="Navegación principal">
            <ul class="flex items-center gap-8 list-none m-0 p-0">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-sm font-medium text-muted-foreground no-underline hover:text-foreground transition-colors"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="flex items-center gap-3">
            <ThemeToggle />
            <Button
                href="#agendar"
                variant="solid"
                size="sm"
                class="hidden sm:inline-flex"
            >
                Agendar
            </Button>

            <div class="relative md:hidden">
                <button
                    id="nav-menu-toggle"
                    class="flex items-center justify-center rounded-full bg-muted p-2.5 text-foreground hover:bg-accent transition-colors"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="nav-menu"
                    aria-label="Abrir menú de navegación"
                >
                    <svg
                        id="nav-menu-icon-open"
                        class="h-5 w-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    <svg
                        id="nav-menu-icon-close"
                        class="hidden h-5 w-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>

                <div
                    id="nav-menu"
                    class="hidden absolute right-0 mt-2 w-52 overflow-hidden rounded-xl border border-border bg-popover shadow-lg"
                >
                    {
                        navLinks.map((link) => (
                            <a
                                href={link.href}
                                class="block px-4 py-2.5 text-sm text-popover-foreground hover:bg-accent transition-colors"
                                data-nav-link
                            >
                                {link.label}
                            </a>
                        ))
                    }

                    <a
                        href="#agendar"
                        class="block px-4 py-2.5 text-sm font-medium text-primary sm:hidden hover:bg-accent transition-colors"
                        data-nav-link
                    >
                        Agendar
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .site-header {
        background-color: transparent;
        border-bottom: 1px solid transparent;
        backdrop-filter: blur(0px);
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease,
            backdrop-filter 0.3s ease;
    }

    .site-header.header--scrolled {
        background-color: color-mix(
            in oklab,
            var(--color-background) 85%,
            transparent
        );
        border-bottom-color: var(--color-border);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
</style>

<script>
    const header = document.getElementById("site-header");

    const toggleHeaderBg = () => {
        if (window.scrollY > 20) {
            header?.classList.add("header--scrolled");
        } else {
            header?.classList.remove("header--scrolled");
        }
    };

    toggleHeaderBg();
    window.addEventListener("scroll", toggleHeaderBg, { passive: true });
</script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const menuToggleBtn = document.getElementById("nav-menu-toggle");
        const menu = document.getElementById("nav-menu");
        const openIcon = document.getElementById("nav-menu-icon-open");
        const closeIcon = document.getElementById("nav-menu-icon-close");

        if (!menuToggleBtn || !menu) return;

        const closeMenu = () => {
            menu.classList.add("hidden");
            openIcon.classList.remove("hidden");
            closeIcon.classList.add("hidden");
            menuToggleBtn.setAttribute("aria-expanded", "false");
        };

        const openMenu = () => {
            menu.classList.remove("hidden");
            openIcon.classList.add("hidden");
            closeIcon.classList.remove("hidden");
            menuToggleBtn.setAttribute("aria-expanded", "true");
        };

        menuToggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen =
                menuToggleBtn.getAttribute("aria-expanded") === "true";
            isOpen ? closeMenu() : openMenu();
        });

        document.querySelectorAll("[data-nav-link]").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        document.addEventListener("click", (e) => {
            if (!menu.contains(e.target) && !menuToggleBtn.contains(e.target)) {
                closeMenu();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeMenu();
        });
    });
</script>
