---
/* src/components/layout/Footer.astro */
const year = new Date().getFullYear();

// Lee las variables de entorno (.env)
const email = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "hola@lukas.dev";
const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${email}`;
const linkedin = import.meta.env.PUBLIC_LINKEDIN_URL ?? "#";
const github = import.meta.env.PUBLIC_GITHUB_URL ?? "#";

const socialLinks = [
    { label: "LinkedIn.", href: linkedin },
    { label: "Github.", href: github },
    { label: "Email.", href: gmailUrl },
];
---

<footer class="w-full py-12 flex flex-col items-center justify-center gap-6">
    <div
        class="inline-flex items-center justify-center gap-1 sm:gap-2 rounded-full bg-[#222222] dark:bg-[#1A1A1A] p-2 sm:px-3 shadow-lg border border-white/5"
    >
        {
            socialLinks.map((link) => (
                <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    class="relative rounded-full px-3 py-1.5 text-xs sm:text-sm font-medium text-gray-400 transition-all duration-300 ease-out hover:-translate-y-0.5 hover:scale-105 hover:bg-white/10 hover:text-white active:scale-95"
                >
                    {link.label}
                </a>
            ))
        }
    </div>

    <p
        class="text-[11px] text-muted-foreground/60 tracking-tight transition-opacity hover:opacity-100"
    >
        © {year} Lukas Garrido. Todos los derechos reservados.
    </p>
</footer>
