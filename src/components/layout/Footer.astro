---
/* src/components/Footer.astro */
const year = new Date().getFullYear();

const socialLinks = [
    { label: "GitHub", href: "https://github.com/LukasGarrido" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/lukasgarrido/" },
    { label: "Correo", href: "mailto:[EMAIL_ADDRESS]" },
];
---

<footer class="border-t border-border bg-background py-8">
    <div
        class="wrapper flex flex-col items-center justify-between gap-4 text-xs text-muted-foreground sm:flex-row"
    >
        <p>© {year} Lukas Garrido. Todos los derechos reservados.</p>

        <ul class="flex items-center gap-5">
            {
                socialLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="transition-colors hover:text-foreground"
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</footer>
