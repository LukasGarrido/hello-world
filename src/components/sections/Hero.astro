---
// src/components/sections/Hero.astro
const stats = [
    { value: "+2", label: "Proyectos\nrealizados" },
    { value: "+3", label: "Experiencias\nprofesionales" },
    { value: "+15", label: "Tecnologías\nen mi stack" },
];

const cards = [
    {
        text: "Backend, APIs, Data Science",
        href: "#experiencia",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>`,
        bgClass: "bg-orange-500",
    },
    {
        text: "FastAPI, Astro, Python, Docker",
        href: "#proyectos",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/></svg>`,
        bgClass: "bg-lime-400",
    },
];
---

<section id="sobre-mi" class="flex flex-col gap-12 fade-on-scroll">
    <!-- Hero heading: two-line massive title -->
    <div class="flex flex-col gap-6">
        <h1 class="hero-title">
            Desarrollador <br class="hidden sm:block" />Fullstack
            <span class="block text-muted-foreground/50"
                >&amp; Data Science</span
            >
        </h1>

        <p
            class="max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
            Soy desarrollador junior y lo que más disfruto es resolver problemas
            reales. Me muevo en el backend, donde me gusta darle orden y
            estructura a las aplicaciones para que sean fáciles de mantener y
            crecer. Últimamente me tiene enganchado la ciencia de datos, y estoy
            aprendiendo todo lo que puedo sobre ella.
        </p>
    </div>

    <!-- Stats row -->
    <div
        class="grid grid-cols-1 gap-8 border-y border-border py-10 sm:grid-cols-3"
    >
        {
            stats.map((s) => (
                <div>
                    <div class="stat-number">{s.value}</div>
                    <div class="stat-label whitespace-pre-line">{s.label}</div>
                </div>
            ))
        }
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
            cards.map((c) => (
                <a
                    href={c.href}
                    class:list={[
                        c.bgClass,
                        "group relative flex flex-col justify-between gap-8 overflow-hidden rounded-2xl p-6 text-black transition-transform duration-300 hover:scale-[1.02] sm:min-h-[180px]",
                    ]}
                >
                    <span class="opacity-80">
                        <Fragment set:html={c.icon} />
                    </span>
                    <span class="font-display text-lg font-bold uppercase leading-tight tracking-tight sm:text-xl">
                        {c.text}
                    </span>
                    <svg
                        class="absolute bottom-4 right-4 h-6 w-6 opacity-40 transition-opacity group-hover:opacity-80"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"
                        />
                    </svg>
                </a>
            ))
        }
    </div>
</section>
