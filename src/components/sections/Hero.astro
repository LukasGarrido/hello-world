---
/* src/components/Hero.astro */
---

<section
    id="sobre-mi"
    class="section-full relative overflow-hidden justify-center fade-on-scroll"
>
    <!-- Fondo Pixel Art decorativo con mezcla de capas -->
    <div
        class="pointer-events-none absolute inset-0 z-0 flex items-end justify-center opacity-15 dark:opacity-25 mix-blend-multiply dark:mix-blend-screen"
    >
        <img
            src="/Google's Dinosaur.png"
            alt=""
            aria-hidden="true"
            class="h-full w-full object-cover object-bottom select-none"
        />
    </div>

    <!-- Contenido del Hero (sobre la capa del fondo) -->
    <div class="wrapper relative z-10 flex flex-col items-center text-center">
        <!-- Píldora de status centrada -->
        <span
            class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card/80 backdrop-blur-sm px-3.5 py-1 text-xs font-medium text-muted-foreground shadow-sm"
        >
            Dev Backend &amp; Data Science
        </span>

        <!-- Título principal centrado -->
        <h1
            class="mt-6 max-w-3xl font-display text-4xl font-bold leading-[1.1] tracking-tight text-foreground sm:text-5xl md:text-6xl"
        >
            Desarrollo de software enfocado en resolver problemas reales.
        </h1>

        <!-- Descripción centrada -->
        <p
            class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
            Soy desarrollador junior y lo que más me mueve es resolver problemas
            reales. Me enfoco en darle estructura a las aplicaciones en el
            backend y me entusiasma todo lo que tenga que ver con trabajar y
            aprender sobre ciencia de datos.
        </p>

        <!-- Botones de acción centrados -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
                href="#proyectos"
                class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
            >
                Mis Proyectos
            </a>

            <a
                href="/cv.pdf"
                download="CV_Lukas_Garrido.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg border border-border bg-card/80 backdrop-blur-sm px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:border-foreground/30 hover:bg-accent"
            >
                Descargar CV
            </a>
        </div>
    </div>
</section>
