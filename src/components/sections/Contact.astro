---
// src/components/sections/Contact.astro
import Button from "../ui/Button.astro";

const token = import.meta.env.PUBLIC_FORMSUBMIT_TOKEN?.trim();
const fallbackEmail =
    import.meta.env.PUBLIC_CONTACT_EMAIL ??
    import.meta.env.PUBLIC_EMAIL ??
    "lukas.garrido3967@gmail.com";

// Si se define un token aleatorio en PUBLIC_FORMSUBMIT_TOKEN, se usa para no exponer el correo en el HTML.
// De lo contrario, se usa el correo como valor para el primer envío de activación.
const formEndpoint = token || fallbackEmail;

interface Props {
    reasons?: readonly string[];
}

const {
    reasons = [
        "Oportunidad laboral",
        "Práctica o pasantía",
        "Proyecto freelance",
        "Colaboración",
        "Otro",
    ],
} = Astro.props;

interface TextField {
    id: string;
    name: "name" | "email";
    label: string;
    type: "text" | "email";
    placeholder: string;
    autocomplete: "name" | "email";
}

const textFields: readonly TextField[] = [
    {
        id: "c-name",
        name: "name",
        label: "Nombre",
        type: "text",
        placeholder: "Tu nombre",
        autocomplete: "name",
    },
    {
        id: "c-email",
        name: "email",
        label: "Email",
        type: "email",
        placeholder: "tu@email.com",
        autocomplete: "email",
    },
];

const fieldClass =
    "w-full rounded-sm border border-border/40 bg-muted/70 px-3.5 py-2.5 text-base text-foreground placeholder:text-muted-foreground outline-none transition focus:border-brand/60 focus:ring-1 focus:ring-brand/60";
const labelClass = "mb-2 block text-xs font-medium text-muted-foreground";
---

<section id="contacto" class="fade-on-scroll">
    <h2 class="section-title">
        Trabajemos
        <span class="block text-foreground/15">Juntos</span>
    </h2>

    <form
        id="contact-form"
        action={`https://formsubmit.co/${formEndpoint}`}
        method="POST"
        class="mt-8 flex max-w-[696px] flex-col gap-5"
        data-endpoint={formEndpoint}
    >
        <!-- Antispam Honeypot: invisible para humanos, bots lo completan y son bloqueados -->
        <input
            type="text"
            name="_honey"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
        />

        <!-- Configuración de FormSubmit -->
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input
            type="hidden"
            name="_subject"
            id="c-subject"
            value="Nuevo mensaje desde el Portfolio"
        />

        <div class="grid gap-5 sm:grid-cols-2">
            {
                textFields.map((f) => (
                    <div>
                        <label for={f.id} class={labelClass}>
                            {f.label}
                        </label>
                        <input
                            id={f.id}
                            name={f.name}
                            type={f.type}
                            placeholder={f.placeholder}
                            autocomplete={f.autocomplete}
                            required
                            class={fieldClass}
                        />
                    </div>
                ))
            }
        </div>

        <div>
            <label for="c-reason" class={labelClass}>Motivo</label>
            <div class="relative">
                <select
                    id="c-reason"
                    name="reason"
                    required
                    class:list={[fieldClass, "appearance-none pr-10"]}
                >
                    <option value="" disabled selected>Selecciona…</option>
                    {
                        reasons.map((reason) => (
                            <option value={reason}>{reason}</option>
                        ))
                    }
                </select>
                <svg
                    class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                </svg>
            </div>
        </div>

        <div>
            <label for="c-message" class={labelClass}>Mensaje</label>
            <textarea
                id="c-message"
                name="message"
                rows="4"
                required
                placeholder="Cuéntame en qué puedo ayudarte"
                class:list={[fieldClass, "min-h-[100px] resize-y"]}></textarea>
        </div>

        <Button
            id="submit-btn"
            type="submit"
            variant="brand"
            class="w-full py-2.5 text-sm"
        >
            Enviar
        </Button>

        <div
            id="form-status"
            class="hidden rounded-sm p-3 text-sm font-medium"
            role="alert"
        >
        </div>
    </form>
</section>

<script>
    function setupContactForm(): void {
        const form = document.querySelector<HTMLFormElement>("#contact-form");
        if (!form || form.dataset.bound === "true") return;
        form.dataset.bound = "true";

        const endpoint = form.dataset.endpoint ?? "";
        const submitBtn =
            form.querySelector<HTMLButtonElement>("#submit-btn");
        const statusEl = form.querySelector<HTMLDivElement>("#form-status");

        form.addEventListener("submit", async (event: SubmitEvent) => {
            event.preventDefault();

            // Antispam: si el campo trampa fue rellenado por un bot, abortar silenciosamente
            const data = new FormData(form);
            if (data.get("_honey")) {
                form.reset();
                return;
            }

            if (!endpoint || endpoint.includes("[EMAIL_ADDRESS]")) {
                if (statusEl) {
                    statusEl.textContent =
                        "Error: La configuración de destino del formulario no es válida.";
                    statusEl.className =
                        "rounded-lg p-3 text-sm font-medium bg-red-500/10 text-red-500 border border-red-500/20";
                    statusEl.classList.remove("hidden");
                }
                return;
            }

            const name = String(data.get("name") ?? "");
            const senderEmail = String(data.get("email") ?? "");
            const reason = String(data.get("reason") ?? "");
            const message = String(data.get("message") ?? "");
            const subject = `[Portafolio] ${reason} — ${name}`;

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = "Enviando...";
            }
            if (statusEl) {
                statusEl.classList.add("hidden");
            }

            try {
                const response = await fetch(
                    `https://formsubmit.co/ajax/${encodeURIComponent(endpoint)}`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json",
                        },
                        body: JSON.stringify({
                            name,
                            email: senderEmail,
                            reason,
                            message,
                            _subject: subject,
                            _honey: "",
                        }),
                    },
                );

                if (!response.ok) {
                    throw new Error("Error en la respuesta del servidor");
                }

                form.reset();
                if (statusEl) {
                    statusEl.textContent =
                        "¡Mensaje enviado con éxito! Te responderé lo antes posible.";
                    statusEl.className =
                        "rounded-sm p-3 text-sm font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20";
                    statusEl.classList.remove("hidden");
                }
            } catch (err) {
                if (statusEl) {
                    const fallbackLink = endpoint.includes("@")
                        ? ` Puedes escribirme directamente a <a href="mailto:${endpoint}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}" class="underline font-semibold hover:text-red-400">${endpoint}</a>.`
                        : " Por favor, inténtalo nuevamente más tarde.";

                    statusEl.innerHTML = `No fue posible enviar el mensaje automáticamente.${fallbackLink}`;
                    statusEl.className =
                        "rounded-sm p-3 text-sm font-medium bg-red-500/10 text-red-500 border border-red-500/20";
                    statusEl.classList.remove("hidden");
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Enviar";
                }
            }
        });
    }

    document.addEventListener("astro:page-load", setupContactForm);
    setupContactForm();
</script>
