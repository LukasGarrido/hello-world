---
/* src/components/Experience.astro */
const experience = [
  {
    role: "Ayudante Docente - Base de datos",
    company: "Universidad Técnica Federico Santa María",
    period: "Marzo 2026 – junio 2026",
    location: "Concepción, Chile",
    steps: [
      { title: "Resolución de Dudas", description: "Atención a estudiantes sobre modelo relacional y consultas compuestas." },
      { title: "Evaluación & Feedback", description: "Revisión técnica de scripts SQL, normalización y diseño conceptual de bases de datos." },
      { title: "Apoyo Docente", description: "Coordinación con el profesor titular para la elaboración de ejercicios y pautas de laboratorio." },
      { title: "Sistemas & Optimización", description: "Orientación en el uso de motores de bases de datos y buenas prácticas de optimización de queries." },
    ],
  },
  {
    role: "Practicante Junior / Fullstack Engineer",
    company: "Siamec Automatización",
    period: "Enero 2026 – Marzo 2026",
    location: "Los Ángeles, Chile",
    steps: [
      { title: "Levantamiento de Requerimientos", description: "Análisis de procesos internos junto a los departamentos operativos de la empresa." },
      { title: "Diseño de Arquitectura", description: "Estructuración de base de datos y diseño de API para el sistema de control interno." },
      { title: "Desarrollo Frontend & Backend", description: "Construcción de módulos interactivos e integración con servicios de almacenamiento local." },
      { title: "Pruebas & Despliegue", description: "Validación de flujos de trabajo, corrección de bugs y puesta en marcha inicial del software." },
    ],
  },
  {
    role: "Practicante de Informática",
    company: "Municipalidad de Los Ángeles",
    period: "Nov 2023 – Dic 2023",
    location: "Los Ángeles, Chile",
    steps: [
      { title: "Desarrollo Web", description: "Apoyo en el desarrollo de herramientas web internas utilizando Python y HTML/CSS." },
      { title: "Soporte Técnico", description: "Mantenimiento preventivo y correctivo de hardware, diagnóstico e instalación de software." },
      { title: "Configuración de Redes", description: "Asistencia en el cableado, configuración de equipos de red y periféricos corporativos." },
    ],
  },
];
---

<section id="experiencia" class="section-full bg-background fade-on-scroll">
  <div class="wrapper">
    <div class="section-head text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          Aplicación de Conocimientos
      </span>
      <h2 class="mt-1 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Trayectoria Profesional
      </h2>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {experience.map((job, jobIdx) => (
        <article class="exp-card flex flex-col justify-between rounded-xl border border-border bg-card p-6 shadow-sm transition-colors hover:border-foreground/20" data-job-index={jobIdx}>
          <div>
            <!-- Header del Puesto -->
            <div class="flex items-center justify-between gap-2 border-b border-border pb-4">
              <div>
                <span class="text-xs font-semibold text-muted-foreground">
                  {job.company}
                </span>
                <h3 class="font-display text-lg font-bold tracking-tight text-foreground">
                  {job.role}
                </h3>
              </div>
              <span class="shrink-0 rounded-md bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground">
                {job.period}
              </span>
            </div>

            <!-- Lista interactiva de Pasos (Accordion manual) -->
            <div class="mt-4 space-y-3">
              {job.steps.map((step, stepIdx) => (
                <div 
                  class="step-item group cursor-pointer overflow-hidden rounded-lg border border-border/50 bg-muted/20 p-3 transition-all duration-300"
                  data-step-index={stepIdx}
                >
                  <div class="flex items-center justify-between text-xs font-semibold text-foreground">
                    <span class="flex items-center gap-2">
                      <span class="step-num text-[10px] text-muted-foreground">0{stepIdx + 1}</span>
                      {step.title}
                    </span>
                  </div>

                  <!-- Contenido expandible -->
                  <div class="step-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
                    <div class="overflow-hidden">
                      <p class="pt-2 text-xs leading-relaxed text-muted-foreground">
                        {step.description}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <p class="mt-6 text-xs text-muted-foreground">
            {job.location}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function setupExperienceAccordion() {
    const cards = document.querySelectorAll('.exp-card');

    cards.forEach((card) => {
      const steps = card.querySelectorAll('.step-item');

      function setActiveStep(index: number) {
        steps.forEach((step, i) => {
          const content = step.querySelector('.step-content') as HTMLElement;

          if (i === index) {
            step.classList.add('border-foreground/30', 'bg-muted/60');
            if (content) content.style.gridTemplateRows = '1fr';
          } else {
            step.classList.remove('border-foreground/30', 'bg-muted/60');
            if (content) content.style.gridTemplateRows = '0fr';
          }
        });
      }

      // Event Listeners exclusivos para interacción por clic
      steps.forEach((step, i) => {
        step.addEventListener('click', () => {
          setActiveStep(i);
        });
      });

      // Primer paso desplegado por defecto al cargar
      setActiveStep(0);
    });
  }

  // Compatibilidad con transiciones de página en Astro
  document.addEventListener('astro:page-load', setupExperienceAccordion);
  setupExperienceAccordion();
</script>