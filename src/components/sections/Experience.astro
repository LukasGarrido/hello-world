---
// src/components/sections/Experience.astro
const experience = [
  {
    company: "Universidad Técnica Federico Santa María",
    summary:
      "Ayudante docente de Bases de Datos. Resolví dudas y revisé scripts SQL y diseños de modelos.",
    period: "Mar 2026 – Jun 2026",
  },
  {
    company: "Siamec Automatización",
    summary:
      "Practicante Fullstack. Diseñé la base de datos y la API, y desarrollé módulos web con Laravel.",
    period: "Ene 2026 – Mar 2026",
  },
  {
    company: "Municipalidad de Los Ángeles",
    summary:
      "Practicante de Informática. Apoyé el desarrollo de herramientas web internas y el soporte técnico.",
    period: "Nov 2023 – Dic 2023",
  },
];
---

<section id="experiencia" class="fade-on-scroll">
  <h2 class="section-title">
    Mi
    <span class="block text-foreground/15">Experiencia</span>
  </h2>

  <ul class="mt-8 flex flex-col gap-2">
    {
      experience.map((job) => (
        <li class="p-4">
          <h3 class="font-display text-xl font-semibold leading-tight text-foreground sm:text-[1.6rem]">
            {job.company}
          </h3>
          <p class="mt-3 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
            {job.summary}
          </p>
          <p class="mt-4 text-base text-muted-foreground">{job.period}</p>
        </li>
      ))
    }
  </ul>
</section>
