---
const experience = [
  {
    role: "Ayudante Docente - Base de datos",
    company: "Universidad Técnica Federico Santa María",
    period: "Marzo 2026 – junio 2026",
    location: "Concepción, Chile",
    description:
      "Apoyo a los estudiantes en el ramo de Base de datos, resolviendo dudas y entregando feedback en sus sistemas de base de datos.",
  },
  {
    role: "Practicante Junior / Fullstack Engineer",
    company: "Siamec Automatización",
    period: "Enero 2026 – Marzo 2026",
    location: "Los Ángeles, Chile",
    description:
      "Desarrollo de sistemas informáticos internos para la empresa Siamec Automatización, siendo mi primera experiencia laboral en el mundo del desarrollo de software.",
  },
  {
    role: "Practicante de Informática",
    company: "Municipalidad de Los Ángeles",
    period: "Noviembre 2023 – Diciembre 2023",
    location: "Los Ángeles, Chile",
    description: "Apoyé el desarrollo web utilizando Python y herramientas básicas de diseño. Brindé soporte informático, incluyendo instalación de software, configuración de equipos y asistencia a usuarios.",
  },
];
---

<section id="experiencia" class="min-h-screen min-h-[100dvh] flex flex-col justify-center mx-auto max-w-6xl px-6 py-24">
  <p class="text-xs font-medium uppercase tracking-wide text-indigo-600">
    Experiencia comprobada
  </p>
  <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
    Trayectoria Profesional
  </h2>

  <div class="relative mt-14">
    <!-- Línea central (desktop) / izquierda (mobile) -->
    <div class="absolute left-4 top-0 h-full w-px bg-slate-200 md:left-1/2 md:-translate-x-1/2"></div>

    <div class="space-y-10 md:space-y-16">
      {experience.map((job, i) => (
        <div class="relative grid grid-cols-1 md:grid-cols-2 md:gap-x-10">
          <!-- Punto en la línea -->
          <span class="absolute left-4 top-1.5 z-10 h-3 w-3 -translate-x-1/2 rounded-full bg-indigo-600 ring-4 ring-[#F8F9FB] md:left-1/2"></span>

          <!-- Card: alterna de columna en desktop, texto siempre a la izquierda -->
          <div class={`pl-10 md:pl-0 ${i % 2 === 0 ? "md:col-start-2 md:pl-10" : "md:col-start-1 md:pr-10"}`}>
            <div class="rounded-2xl border border-slate-200 bg-white p-5 text-left">
              <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-600">
                {job.period}
              </span>
              <h3 class="mt-3 text-base font-semibold text-slate-900">{job.role}</h3>
              <p class="text-sm text-slate-500">
                {job.company} · {job.location}
              </p>

              <p class="mt-3 text-sm leading-relaxed text-slate-500">
                {job.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>