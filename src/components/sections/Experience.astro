---
/* src/components/sections/Experience.astro */

const experience = [
  {
    role: "Ayudante Docente - Base de datos",
    company: "Universidad Técnica Federico Santa María",
    period: "Mar 2026 – Jun 2026",
    location: "Concepción, Chile",
    techs: [
      { name: "MySQL", icon: "/Stack/mysql-icon-light.svg" },
      { name: "Obsidian", icon: "/Stack/obsidian.svg" },
    ],
    steps: [
      {
        title: "Resolución de Dudas",
        description:
          "Atención a estudiantes sobre modelo relacional, consultas compuestas, etc.",
      },
      {
        title: "Evaluación & Feedback",
        description:
          "Revisión de scripts SQL, normalización y diseño conceptual de bases de datos.",
      },
      {
        title: "Apoyo Docente",
        description:
          "Coordinación con el profesor titular para la elaboración de ejercicios y pautas de laboratorio.",
      },
      {
        title: "Sistemas & Optimización",
        description:
          "Orientación en el uso de motores de bases de datos y buenas prácticas de optimización de queries.",
      },
    ],
  },
  {
    role: "Practicante de Desarrollo Fullstack",
    company: "Siamec Automatización",
    period: "Ene 2026 – Mar 2026",
    location: "Los Ángeles, Chile",
    techs: [
      { name: "Laravel", icon: "/Stack/laravel.svg" },
      { name: "MySQL", icon: "/Stack/mysql-icon-light.svg" },
      { name: "Bootstrap", icon: "/Stack/bootstrap.svg" },
      { name: "Docker", icon: "/Stack/docker.svg" },
      { name: "Git", icon: "/Stack/git.svg" },
      { name: "Antigravity IDE", icon: "/Stack/antigravity.svg" },
      { name: "Obsidian", icon: "/Stack/obsidian.svg" },
    ],
    steps: [
      {
        title: "Levantamiento de Requerimientos",
        description:
          "Análisis de procesos internos y definición de requerimientos técnicos.",
      },
      {
        title: "Diseño de Arquitectura",
        description:
          "Estructura de base de datos y diseño de endpoints API.",
      },
      {
        title: "Desarrollo Frontend & Backend",
        description:
          "Construí módulos interactivos e integré servicios de almacenamiento, facilitando la gestión de [DATO] registros diarios.",
      },
      {
        title: "Pruebas & Despliegue",
        description:
          "Validación de flujos de trabajo y corrección de bugs críticos.",
      },
    ],
  },
  {
    role: "Practicante de Informática",
    company: "Municipalidad de Los Ángeles",
    period: "Nov 2023 – Dic 2023",
    location: "Los Ángeles, Chile",
    techs: [
      { name: "Python", icon: "/Stack/python.svg" },
      { name: "HTML5", icon: "/Stack/html5.svg" },
      { name: "CSS3", icon: "/Stack/css3.svg" },
      { name: "VSCode", icon: "/Stack/vscode.svg" },
      { name: "Notion", icon: "/Stack/notion.svg" },
    ],
    steps: [
      {
        title: "Desarrollo Web",
        description:
          "Apoyo en el desarrollo de herramientas web internas utilizando Python y HTML/CSS.",
      },
      {
        title: "Soporte Técnico",
        description:
          "Mantenimiento preventivo y correctivo a equipos de hardware y resolución de incidencias de software.",
      },
    ],
  },
];
---

<section id="experiencia" class="section py-20 fade-on-scroll">
  <div class="wrapper">
    <div class="flex flex-col items-center text-center mb-12">
      <h2
        class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl"
      >
        <span class="font-serif italic font-normal text-brand">Experiencia</span
        >
        Laboral
      </h2>
      <p class="mt-3 max-w-lg text-sm sm:text-base text-muted-foreground">
        Experiencia práctica aplicada en docencia universitaria, ingeniería de
        software y soporte de infraestructura.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {
        experience.map((job, jobIdx) => (
          <article
            class="exp-card flex flex-col justify-between rounded-2xl border border-border/30 bg-muted/10 dark:bg-card/20 p-6 backdrop-blur-sm transition-all duration-300 hover:border-border/60 hover:bg-muted/20"
            data-job-index={jobIdx}
          >
            <div>
              <div class="border-b border-border/30 pb-4 mb-4">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-semibold text-muted-foreground">
                    {job.company}
                  </span>
                  <span class="text-xs font-medium text-muted-foreground/80">
                    {job.period}
                  </span>
                </div>

                <h3 class="font-display text-base font-bold text-foreground leading-snug">
                  {job.role}
                </h3>
              </div>

              <div class="space-y-1.5">
                {job.steps.map((step, stepIdx) => (
                  <div
                    class="step-item group/step cursor-pointer overflow-hidden rounded-lg border border-transparent p-2.5 transition-all duration-200 hover:bg-muted/40"
                    data-step-index={stepIdx}
                  >
                    <div class="flex items-center justify-between text-xs font-semibold text-foreground">
                      <span class="flex items-center gap-2">
                        <span class="step-num text-[10px] font-semibold text-brand">
                          0{stepIdx + 1}.
                        </span>
                        {step.title}
                      </span>
                      <svg
                        class="step-chevron h-3.5 w-3.5 text-muted-foreground/60 transition-transform duration-200"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                        />
                      </svg>
                    </div>

                    <div class="step-content grid grid-rows-[0fr] transition-all duration-200 ease-out">
                      <div class="overflow-hidden">
                        <p class="pt-2 text-xs leading-relaxed text-muted-foreground/80">
                          {step.description}
                        </p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Footer con Ubicación e Iconos del Stack -->
            <div class="mt-6 pt-4 border-t border-border/30 flex flex-col gap-3">
              <!-- Íconos de Tecnologías sin fondo y con sus colores originales -->
              <div class="flex flex-wrap items-center gap-3">
                {job.techs.map((tech) => (
                  <div
                    class="inline-flex items-center gap-1.5 text-[11px] font-medium text-muted-foreground"
                    title={tech.name}
                  >
                    <img
                      src={tech.icon}
                      alt={tech.name}
                      class="h-4 w-4 object-contain"
                      loading="lazy"
                    />
                    <span>{tech.name}</span>
                  </div>
                ))}
              </div>

              <div class="flex items-center justify-between text-[11px] text-muted-foreground/70">
                <span>{job.location}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupExperienceAccordion() {
    const cards = document.querySelectorAll(".exp-card");

    cards.forEach((card) => {
      const steps = card.querySelectorAll(".step-item");

      function setActiveStep(index: number) {
        steps.forEach((step, i) => {
          const content = step.querySelector(".step-content") as HTMLElement;
          const chevron = step.querySelector(".step-chevron") as HTMLElement;

          if (i === index) {
            step.classList.add(
              "bg-muted/50",
              "dark:bg-muted/40",
              "border-border/20",
            );
            if (content) content.style.gridTemplateRows = "1fr";
            if (chevron) chevron.style.transform = "rotate(180deg)";
          } else {
            step.classList.remove(
              "bg-muted/50",
              "dark:bg-muted/40",
              "border-border/20",
            );
            if (content) content.style.gridTemplateRows = "0fr";
            if (chevron) chevron.style.transform = "rotate(0deg)";
          }
        });
      }

      steps.forEach((step, i) => {
        step.addEventListener("click", () => {
          setActiveStep(i);
        });
      });

      setActiveStep(0);
    });
  }

  document.addEventListener("astro:page-load", setupExperienceAccordion);
  setupExperienceAccordion();
</script>