---
/* src/components/Projects.astro */
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order
);
---

<section id="proyectos" class="section-full bg-background fade-on-scroll">
    <div class="wrapper">
        <div class="section-head flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Especialización en acción
                </span>
                <h2 class="mt-1 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    Proyectos
                </h2>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
                Sistemas y herramientas seleccionadas desarrolladas con enfoque en rendimiento, arquitectura limpia y datos.
            </p>
        </div>

        <!-- Grid sobrio estilo Stack -->
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
                projects.map((project) => (
                    <article class="flex flex-col justify-between rounded-xl border border-border bg-card p-6 shadow-sm transition-colors hover:border-foreground/20">
                        <div>
                            <!-- Encabezado con título y enlaces externos -->
                            <div class="flex items-start justify-between gap-3">
                                <h3 class="font-display text-base font-bold text-foreground">
                                    {project.data.title}
                                </h3>
                                <div class="flex items-center gap-2.5 text-muted-foreground shrink-0">
                                    {project.data.links?.find((l) => l.label.toLowerCase().includes("github")) && (
                                        <a
                                            href={project.data.links.find((l) => l.label.toLowerCase().includes("github"))?.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="transition-colors hover:text-foreground"
                                            aria-label="Ver código en GitHub"
                                        >
                                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            </div>

                            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                                {project.data.description}
                            </p>
                        </div>

                        <div>
                            <!-- Etiquetas de tecnologías integradas -->
                            {project.data.tags && (
                                <div class="mt-6 pt-4 border-t border-border/50">
                                    <ul class="flex flex-wrap gap-1.5">
                                        {project.data.tags.map((tag: string) => (
                                            <li class="rounded-md bg-secondary/60 px-2 py-0.5 text-xs text-secondary-foreground">
                                                {tag}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}

                            <!-- Botón para ver la vista detallada independiente -->
                            <div class="mt-4 pt-3 flex items-center justify-between border-t border-border/40">
                                <a
                                    href={`/proyectos/${project.id}`}
                                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-foreground hover:text-primary transition-colors"
                                >
                                    Ver detalle del proyecto
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>