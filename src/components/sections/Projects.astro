---
/* src/components/sections/Projects.astro */
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order
);

// Extraer categorías únicas para los filtros dinámicos
const categories = ["Todos", ...new Set(projects.map((p) => p.data.category))];
---

<section id="proyectos" class="section py-20 fade-on-scroll">
    <div class="wrapper">
        <div class="flex flex-col items-center text-center">
            
            <h2 class="font-display text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
                Find My Work
            </h2>
            
            <p class="mt-3 max-w-lg text-base text-muted-foreground">
                Una selección de proyectos enfocados en arquitectura escalable, lógica backend y experiencia de usuario.
            </p>
        </div>

        <!-- Filtros tipo Píldora (Tab Switcher) -->
        <div class="mt-8 flex justify-center">
            <div class="inline-flex flex-wrap items-center justify-center gap-1.5 rounded-full border border-border bg-muted/60 p-1.5 backdrop-blur-md">
                {
                    categories.map((category, index) => (
                        <button
                            type="button"
                            data-filter={category}
                            class={`project-tab-btn rounded-full px-5 py-2 text-xs font-semibold transition-all duration-300 ${
                                index === 0
                                    ? "bg-card text-foreground shadow-sm"
                                    : "text-muted-foreground hover:text-foreground"
                            }`}
                        >
                            {category}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Grilla Bento de Tarjetas -->
        <div class="mt-12 grid gap-8 sm:grid-cols-2">
            {
                projects.map((project) => {
                    const heroImage = project.data.heroImage ?? project.data.backgroundImg ?? "/images/LevelWorksHero.png";
                    const githubLink = project.data.links?.find((l) => 
                        l.label.toLowerCase().includes("github") || l.label.toLowerCase().includes("código")
                    )?.href;

                    return (
                        <article 
                            data-category={project.data.category}
                            class="project-card group relative flex flex-col overflow-hidden rounded-3xl border border-border bg-card p-4 transition-all duration-300 hover:-translate-y-1 hover:border-foreground/20 hover:shadow-xl"
                        >
                            <!-- Contenedor de Imagen de Portada -->
                            <div class="relative h-64 w-full overflow-hidden rounded-2xl bg-muted">
                                <img
                                    src={heroImage}
                                    alt={project.data.title}
                                    class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                                />
                                <div class="absolute top-3 left-3">
                                    <span class="rounded-full border border-border/60 bg-card/90 backdrop-blur-md px-3 py-1 text-[11px] font-semibold text-foreground shadow-sm">
                                        {project.data.category}
                                    </span>
                                </div>
                            </div>

                            <!-- Información de la Tarjeta -->
                            <div class="flex flex-1 flex-col justify-between p-4">
                                <div>
                                    <div class="flex items-center justify-between gap-2">
                                        <h3 class="font-display text-xl font-bold text-foreground transition-colors group-hover:text-brand">
                                            <a href={`/proyectos/${project.id}`}>
                                                {project.data.title}
                                            </a>
                                        </h3>

                                        {githubLink && (
                                            <a
                                                href={githubLink}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                                aria-label="Ver código en GitHub"
                                            >
                                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                                                </svg>
                                            </a>
                                        )}
                                    </div>

                                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2">
                                        {project.data.description}
                                    </p>
                                </div>

                                <!-- Tags de Tecnologías -->
                                {project.data.tags && (
                                    <div class="mt-4 flex flex-wrap gap-1.5 pt-3 border-t border-border/40">
                                        {project.data.tags.map((tag: string) => (
                                            <span class="rounded-full bg-muted px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
</section>

<script>
    // Filtrado dinámico client-side
    const buttons = document.querySelectorAll(".project-tab-btn");
    const cards = document.querySelectorAll(".project-card");

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const filter = button.getAttribute("data-filter");

            // Cambiar estado activo de las pestañas
            buttons.forEach((btn) => {
                btn.classList.remove("bg-card", "text-foreground", "shadow-sm");
                btn.classList.add("text-muted-foreground");
            });
            button.classList.add("bg-card", "text-foreground", "shadow-sm");
            button.classList.remove("text-muted-foreground");

            // Filtrar las tarjetas
            cards.forEach((card) => {
                const category = card.getAttribute("data-category");
                if (filter === "Todos" || category === filter) {
                    (card as HTMLElement).style.display = "flex";
                } else {
                    (card as HTMLElement).style.display = "none";
                }
            });
        });
    });
</script>