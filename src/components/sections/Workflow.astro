---
/* src/components/sections/Workflow.astro */

const categories = [
    { id: "fullstack", label: "Fullstack / APIs" },
    { id: "frontend", label: "Landing / Frontend" },
    { id: "data", label: "Data Science & Scripting" },
];

const workflowData = {
    fullstack: [
        {
            step: "01",
            title: "Modelado & Arquitectura",
            desc: "Diseño conceptual de datos, estructuración de entidades y definición clara de contratos de interfaz (APIs).",
            tag: "Diseño",
        },
        {
            step: "02",
            title: "Desarrollo de Lógica & APIs",
            desc: "Construcción del core del sistema con código limpio, tipado seguro y separación estricta de responsabilidades.",
            tag: "Desarrollo",
        },
        {
            step: "03",
            title: "Aislamiento & Entornos",
            desc: "Estandarización del entorno de ejecución para asegurar comportamiento idéntico entre desarrollo y producción.",
            tag: "Calidad",
        },
        {
            step: "04",
            title: "Despliegue & Monitoreo",
            desc: "Puesta en producción mediante integración continua, validación de endpoints y verificación de rendimiento.",
            tag: "Entrega",
        },
    ],
    frontend: [
        {
            step: "01",
            title: "Estructura & Prototipado",
            desc: "Definición de componentes modulares, jerarquía visual y maquetación orientada a la experiencia de usuario.",
            tag: "UI/UX",
        },
        {
            step: "02",
            title: "Construcción Modular",
            desc: "Desarrollo de la interfaz de usuario con estilizado semántico, adaptación responsiva y código altamente reutilizable.",
            tag: "Desarrollo",
        },
        {
            step: "03",
            title: "Optimización & Accesibilidad",
            desc: "Mejora de tiempos de carga, estándares web, estructura SEO y rendimiento general del lado del cliente.",
            tag: "Rendimiento",
        },
        {
            step: "04",
            title: "Publicación & Caché",
            desc: "Generación del build de producción y despliegue distribuido optimizado para baja latencia.",
            tag: "Deploy",
        },
    ],
    data: [
        {
            step: "01",
            title: "Ingesta & Fuentes",
            desc: "Extracción y consolidación de datos desde servicios externos, archivos o bases de datos heterogéneas.",
            tag: "Fase ETL",
        },
        {
            step: "02",
            title: "Limpieza & Estructuración",
            desc: "Tratamiento de valores nulos, depuración de anomalías y normalización de conjuntos de datos.",
            tag: "Procesamiento",
        },
        {
            step: "03",
            title: "Análisis & Insights",
            desc: "Agregación de métricas clave, identificación de patrones de negocio y estructuración de resultados.",
            tag: "Análisis",
        },
        {
            step: "04",
            title: "Automatización & Tareas",
            desc: "Programación de flujos de ejecución automática y generación periódica de reportes técnicos.",
            tag: "Orquestación",
        },
    ],
};
---

<section id="metodologia" class="section py-20 fade-on-scroll overflow-hidden">
    <div class="wrapper">
        <div class="flex flex-col items-center text-center mb-10">
            <h2
                class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl"
            >
                <span class="font-serif italic font-normal text-brand"
                    >Pipeline &</span
                > Work Process.
            </h2>
            <p class="mt-3 max-w-lg text-sm sm:text-base text-muted-foreground">
                Procesos estructurados y metodologías aplicadas según el dominio
                técnico del proyecto.
            </p>

            <div
                class="mt-8 inline-flex flex-wrap items-center justify-center gap-1.5 rounded-full border border-border bg-card p-1.5 shadow-sm"
            >
                {
                    categories.map((cat, idx) => (
                        <button
                            type="button"
                            data-workflow-btn={cat.id}
                            data-index={idx}
                            class={`workflow-tab-btn rounded-full px-5 py-2 text-xs font-semibold transition-all duration-200 cursor-pointer ${
                                idx === 0
                                    ? "bg-foreground text-background shadow-sm"
                                    : "text-muted-foreground hover:text-foreground hover:bg-muted/50"
                            }`}
                        >
                            {cat.label}
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="relative w-full overflow-hidden">
            <div
                id="workflow-track"
                class="flex w-full transition-transform duration-500 ease-out"
            >
                {
                    Object.entries(workflowData).map(([catId, steps]) => (
                        <div
                            id={`workflow-group-${catId}`}
                            class="workflow-group w-full shrink-0"
                        >
                            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                                {steps.map((item) => (
                                    <div class="flex flex-col justify-between rounded-xl border border-border/80 bg-card p-6 shadow-sm transition-all duration-200 hover:border-border hover:shadow-md">
                                        <div>
                                            <div class="flex items-center justify-between mb-4">
                                                <span class="font-display text-xl font-bold text-brand">
                                                    {item.step}.
                                                </span>
                                                <span class="rounded-md bg-muted px-2.5 py-0.5 text-[10px] font-semibold text-muted-foreground">
                                                    {item.tag}
                                                </span>
                                            </div>

                                            <h3 class="font-display text-base font-bold text-foreground">
                                                {item.title}
                                            </h3>

                                            <p class="mt-2 text-xs leading-relaxed text-muted-foreground/90">
                                                {item.desc}
                                            </p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    function setupWorkflowTabs() {
        const buttons = document.querySelectorAll("[data-workflow-btn]");
        const track = document.getElementById("workflow-track");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const index = parseInt(
                    btn.getAttribute("data-index") || "0",
                    10,
                );

                // Actualizar clases de los botones activos
                buttons.forEach((b) => {
                    b.classList.remove(
                        "bg-foreground",
                        "text-background",
                        "shadow-sm",
                    );
                    b.classList.add(
                        "text-muted-foreground",
                        "hover:text-foreground",
                    );
                });

                btn.classList.add(
                    "bg-foreground",
                    "text-background",
                    "shadow-sm",
                );
                btn.classList.remove("text-muted-foreground");

                // Desplazar el contenedor
                if (track) {
                    track.style.transform = `translateX(-${index * 100}%)`;
                }
            });
        });
    }

    document.addEventListener("astro:page-load", setupWorkflowTabs);
    setupWorkflowTabs();
</script>
