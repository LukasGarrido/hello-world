---
// src/components/sections/Workflow.astro
const workflows = [
    {
        title: "Backend",
        summary:
            "Modelo la base de datos, construyo la API REST separando responsabilidades y la despliego.",
        steps: ["Modelado", "API", "Integración", "Despliegue"],
    },
    {
        title: "Frontend",
        summary:
            "Defino la jerarquía visual, armo componentes responsivos, consumo APIs y publico el build.",
        steps: ["Maquetación", "Componentes", "Datos", "Deploy"],
    },
    {
        title: "Data Science",
        summary:
            "Extraigo datos de distintas fuentes, los limpio, analizo patrones y automatizo los reportes.",
        steps: ["Ingesta", "Limpieza", "Análisis", "Automatización"],
    },
];
---

<section id="metodologia" class="fade-on-scroll">
    <h2 class="section-title">
        Mi
        <span class="block text-foreground/15">Metodología</span>
    </h2>

    <ul class="mt-8 flex flex-col gap-2">
        {
            workflows.map((w) => (
                <li class="p-4">
                    <h3 class="font-display text-xl font-semibold leading-tight text-foreground sm:text-[1.6rem]">
                        {w.title}
                    </h3>
                    <p class="mt-3 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                        {w.summary}
                    </p>
                    <div class="mt-4 flex items-center justify-between gap-4 text-base text-muted-foreground">
                        <span>{w.steps.join(" → ")}</span>
                        <span class="shrink-0">{w.steps.length} pasos</span>
                    </div>
                </li>
            ))
        }
    </ul>
</section>
