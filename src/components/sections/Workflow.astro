---
/* src/components/sections/Workflow.astro */

const categories = [
    { id: "fullstack", label: "Fullstack / APIs" },
    { id: "frontend", label: "Landing / Frontend" },
    { id: "data", label: "Data Science & Scripting" },
];

const workflowData = {
    fullstack: [
        {
            step: "01",
            title: "Modelado & Arquitectura",
            desc: "Diseño conceptual de datos, estructuración de entidades y definición clara de contratos de interfaz (APIs).",
            tag: "Diseño",
        },
        {
            step: "02",
            title: "Desarrollo de Lógica & APIs",
            desc: "Construcción del core del sistema con código limpio, tipado seguro y separación estricta de responsabilidades.",
            tag: "Desarrollo",
        },
        {
            step: "03",
            title: "Aislamiento & Entornos",
            desc: "Estandarización del entorno de ejecución para asegurar comportamiento idéntico entre desarrollo y producción.",
            tag: "Calidad",
        },
        {
            step: "04",
            title: "Despliegue & Monitoreo",
            desc: "Puesta en producción mediante integración continua, validación de endpoints y verificación de rendimiento.",
            tag: "Entrega",
        },
    ],
    frontend: [
        {
            step: "01",
            title: "Estructura & Prototipado",
            desc: "Definición de componentes modulares, jerarquía visual y maquetación orientada a la experiencia de usuario.",
            tag: "Diseño UI/UX",
        },
        {
            step: "02",
            title: "Construcción Modular",
            desc: "Desarrollo de la interfaz de usuario con estilizado semántico, adaptación responsiva y código altamente reutilizable.",
            tag: "Desarrollo",
        },
        {
            step: "03",
            title: "Optimización & Accesibilidad",
            desc: "Mejora de tiempos de carga, estándares web, estructura SEO y rendimiento general del lado del cliente.",
            tag: "Rendimiento",
        },
        {
            step: "04",
            title: "Publicación & Caché",
            desc: "Generación del build de producción y despliegue distribuido optimizado para baja latencia.",
            tag: "Deploy",
        },
    ],
    data: [
        {
            step: "01",
            title: "Ingesta & Fuentes",
            desc: "Extracción y consolidación de datos desde servicios externos, archivos o bases de datos heterogéneas.",
            tag: "Fase ETL",
        },
        {
            step: "02",
            title: "Limpieza & Estructuración",
            desc: "Tratamiento de valores nulos, depuración de anomalías y normalización de conjuntos de datos.",
            tag: "Procesamiento",
        },
        {
            step: "03",
            title: "Análisis & Insights",
            desc: "Agregación de métricas clave, identificación de patrones de negocio y estructuración de resultados.",
            tag: "Análisis",
        },
        {
            step: "04",
            title: "Automatización & Tareas",
            desc: "Programación de flujos de ejecución automática y generación periódica de reportes técnicos.",
            tag: "Orquestación",
        },
    ],
};
---

<section
    id="metodologia"
    class="section-full bg-muted/30 border-y border-border/60 py-20 fade-on-scroll overflow-hidden"
>
    <div class="wrapper">
        <!-- Encabezado + Filtros -->
        <div
            class="flex flex-col justify-between gap-6 md:flex-row md:items-end"
        >
            <div>
                <span
                    class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                    Pipeline & Metodología
                </span>
                <h2
                    class="mt-1 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
                >
                    Flujo de Trabajo
                </h2>
            </div>

            <!-- Filtro Interactivo -->
            <div
                class="inline-flex flex-wrap items-center gap-1.5 rounded-xl border border-border bg-card p-1.5 shadow-inner"
            >
                {
                    categories.map((cat, idx) => (
                        <button
                            type="button"
                            data-filter-btn={cat.id}
                            data-index={idx}
                            class:list={[
                                "workflow-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all duration-200 cursor-pointer",
                                idx === 0
                                    ? "bg-primary text-primary-foreground shadow-sm"
                                    : "text-muted-foreground hover:text-foreground hover:bg-muted/50",
                            ]}
                        >
                            {cat.label}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Slider Contenedor de Ancho Completo con Transición Horizontal -->
        <div class="relative mt-10 w-full overflow-hidden">
            <div
                id="workflow-track"
                class="flex w-full transition-transform duration-500 ease-out"
            >
                {
                    Object.entries(workflowData).map(([catId, steps]) => (
                        <div
                            id={`workflow-group-${catId}`}
                            class="workflow-group w-full shrink-0"
                        >
                            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                                {steps.map((item) => (
                                    <div class="flex flex-col justify-between rounded-2xl border border-border bg-card p-6 shadow-sm transition-transform duration-200 hover:-translate-y-1 hover:border-foreground/40">
                                        <div>
                                            <div class="flex items-center justify-between">
                                                <span class="font-display text-2xl font-bold text-muted-foreground/50">
                                                    {item.step}
                                                </span>
                                                <span class="rounded-md bg-secondary/80 px-2.5 py-0.5 text-[10px] font-semibold text-secondary-foreground border border-border/50">
                                                    {item.tag}
                                                </span>
                                            </div>

                                            <h3 class="mt-4 font-display text-base font-bold text-foreground">
                                                {item.title}
                                            </h3>

                                            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                                {item.desc}
                                            </p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const filterBtns = document.querySelectorAll("[data-filter-btn]");
        const track = document.getElementById("workflow-track");

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetIndex = parseInt(
                    btn.getAttribute("data-index") || "0",
                    10,
                );

                // Actualizar estilo activo en los botones
                filterBtns.forEach((b) => {
                    b.classList.remove(
                        "bg-primary",
                        "text-primary-foreground",
                        "shadow-sm",
                    );
                    b.classList.add(
                        "text-muted-foreground",
                        "hover:text-foreground",
                        "hover:bg-muted/50",
                    );
                });

                btn.classList.add(
                    "bg-primary",
                    "text-primary-foreground",
                    "shadow-sm",
                );
                btn.classList.remove(
                    "text-muted-foreground",
                    "hover:text-foreground",
                    "hover:bg-muted/50",
                );

                // Desplazar el track horizontalmente
                if (track) {
                    track.style.transform = `translateX(-${targetIndex * 100}%)`;
                }
            });
        });
    });
</script>
