---
/* src/components/sections/Education.astro */

const education = [
    {
        degree: "Ing. en Informática",
        institution: "Universidad Técnica Federico Santa María",
        period: "2024 – Presente",
        location: "Concepción, Chile",
        status: "En Proceso",
        isCurrent: true,
        type: "Educación Superior",
        description:
            "Formación orientada al diseño y construcción de software de calidad, modelamiento de bases de datos, algoritmos computacionales y arquitectura de sistemas.",
        skills: [
            "Bases de Datos & SQL",
            "Desarrollo web Backend",
            "Data Science",
        ],
    },
    {
        degree: "Técnico en Computación e Informática",
        institution: "Centro Educacional Adventista Los Ángeles",
        period: "Graduado",
        location: "Los Ángeles, Chile",
        status: "Titulado",
        isCurrent: false,
        type: "Educación Media TP",
        description:
            "Formación técnica orientada a soporte, mantenimiento de hardware/software y fundamentos de lógica para desarrollo web.",
        skills: [
            "Lógica & Desarrollo Web",
            "Mantenimiento & Hardware",
        ],
    },
];
---

<section id="formacion" class="section py-20 fade-on-scroll">
    <div class="wrapper">
        <div class="flex flex-col items-center text-center mb-16">
            <h2 class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl">
                <span class="font-serif italic font-normal text-brand">Academic</span> Background.
            </h2>
            <p class="mt-3 max-w-lg text-sm sm:text-base text-muted-foreground">
                Fundamentos teóricos e ingeniería práctica combinados para construir soluciones de software robustas.
            </p>
        </div>

        <div class="relative mx-auto max-w-3xl pl-6 sm:pl-8 border-l border-border/70 space-y-12">
            {
                education.map((item) => (
                    <article class="relative group">
                        <!-- Indicador en la línea de tiempo (Nodo) -->
                        <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 flex h-4 w-4 items-center justify-center rounded-full bg-background border border-border group-hover:border-brand transition-colors">
                            {item.isCurrent ? (
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-brand"></span>
                                </span>
                            ) : (
                                <span class="h-1.5 w-1.5 rounded-full bg-muted-foreground/50 group-hover:bg-foreground transition-colors"></span>
                            )}
                        </div>

                        <div class="rounded-xl border border-border/80 bg-card p-6 shadow-sm transition-all duration-200 hover:border-border hover:shadow-md">
                            <!-- Cabecera -->
                            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-border/60 pb-4">
                                <div>
                                    <span class="text-[11px] font-semibold tracking-wider text-muted-foreground uppercase">
                                        {item.type}
                                    </span>
                                    <h3 class="font-display text-lg font-bold text-foreground mt-0.5">
                                        {item.degree}
                                    </h3>
                                    <p class="text-xs text-brand font-medium mt-0.5">
                                        {item.institution}
                                    </p>
                                </div>

                                <div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
                                    <span class={`rounded-md px-2.5 py-1 text-[11px] font-medium border ${
                                        item.isCurrent 
                                            ? "bg-brand/10 border-brand/20 text-brand" 
                                            : "bg-muted border-border/60 text-muted-foreground"
                                    }`}>
                                        {item.status}
                                    </span>
                                </div>
                            </div>

                            <!-- Descripción -->
                            <p class="mt-4 text-xs sm:text-sm leading-relaxed text-muted-foreground/90">
                                {item.description}
                            </p>

                            <div class="mt-5 pt-3 border-t border-border/40 flex flex-wrap items-center justify-between gap-3">
                                <ul class="flex flex-wrap gap-1.5 m-0 p-0 list-none">
                                    {item.skills.map((skill) => (
                                        <li class="rounded-lg bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-foreground/80">
                                            {skill}
                                        </li>
                                    ))}
                                </ul>

                                <span class="text-[11px] text-muted-foreground/70">
                                    {item.location} · {item.period}
                                </span>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>