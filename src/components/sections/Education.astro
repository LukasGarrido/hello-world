---
// src/components/sections/Education.astro
const education = [
    {
        degree: "Ing. en Informática",
        institution: "Universidad Técnica Federico Santa María",
        summary:
            "Software, bases de datos, algoritmos y arquitectura de sistemas.",
        period: "2024 – Presente",
    },
    {
        degree: "Técnico en Computación e Informática",
        institution: "Centro Educacional Adventista Los Ángeles",
        summary:
            "Fundamentos de programación y soporte de hardware y software.",
        period: "Titulado",
    },
];
---

<section id="formacion" class="fade-on-scroll">
    <h2 class="section-title">
        Mi
        <span class="block text-foreground/15">Formación</span>
    </h2>

    <ul class="mt-8 flex flex-col gap-2">
        {
            education.map((item) => (
                <li class="p-4">
                    <h3 class="font-display text-xl font-semibold leading-tight text-foreground sm:text-[1.6rem]">
                        {item.degree}
                    </h3>
                    <p class="mt-1 text-base text-brand sm:text-lg">
                        {item.institution}
                    </p>
                    <p class="mt-3 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                        {item.summary}
                    </p>
                    <p class="mt-4 text-base text-muted-foreground">
                        {item.period}
                    </p>
                </li>
            ))
        }
    </ul>
</section>
