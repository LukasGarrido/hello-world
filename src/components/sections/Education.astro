---
/* src/components/Education.astro */
const education = [
    {
        degree: "Ing. en Informática",
        institution: "Universidad Técnica Federico Santa María",
        period: "2024 – Presente",
        location: "Concepción, Chile",
        status: "En Proceso",
        type: "Educación Superior",
        description:
            "Formación orientada al diseño y construcción de software de calidad, modelamiento de bases de datos, algoritmos computacionales y arquitectura de sistemas.",
        skills: [
            { name: "Bases de Datos & SQL", level: "Medio" },
            { name: "Desarrollo web Backend", level: "En curso" },
            { name: "Data Science", level: "En curso" },
        ],
    },
    {
        degree: "Técnico en Computación e Informática",
        institution: "Centro Educacional Adventista Los Ángeles",
        period: "Graduado",
        location: "Los Ángeles, Chile",
        status: "Titulado",
        type: "Educación Media TP",
        description:
            "Formación técnica orientada a soporte, mantenimiento de hardware/software y fundamentos de lógica para desarrollo web.",
        skills: [
            { name: "Lógica & Desarrollo Web", level: "Medio" },
            { name: "Mantenimiento & Hardware", level: "Medio" },
        ],
    },
];
---

<section id="formacion" class="section-full justify-center fade-on-scroll">
    <div class="wrapper">
        <div
            class="section-head flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
        >
            <div>
                <span
                    class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                    Trayectoria académica
                </span>
                <h2
                    class="mt-1 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
                >
                    Educación & Formación
                </h2>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
                Bases académicas y especialización técnica que respaldan mi
                perfil, combinando rigor conceptual y aplicación práctica.
            </p>
        </div>

        <!-- Grid sobrio idéntico al diseño original -->
        <div class="grid gap-6 md:grid-cols-2">
            {
                education.map((item) => (
                    <article class="flex flex-col justify-between rounded-xl border border-border bg-card p-6 shadow-sm transition-colors hover:border-foreground/20">
                        <div>
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                                        {item.type}
                                    </span>
                                    <h3 class="mt-1 font-display text-base font-bold text-foreground">
                                        {item.degree}
                                    </h3>
                                    <p class="mt-0.5 text-xs text-muted-foreground">
                                        {item.institution} · {item.location} (
                                        {item.period})
                                    </p>
                                </div>
                                <div class="shrink-0">
                                    <span class="inline-flex items-center gap-1 rounded-md bg-secondary/80 px-2.5 py-1 text-xs font-medium text-secondary-foreground">
                                        {item.status}
                                    </span>
                                </div>
                            </div>

                            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                                {item.description}
                            </p>
                        </div>

                        <div class="mt-6 pt-4 border-t border-border/50">
                            <ul class="flex flex-wrap gap-1.5">
                                {item.skills.map((skill) => (
                                    <li class="inline-flex items-center gap-1.5 rounded-md bg-secondary/60 px-2.5 py-1 text-xs font-medium text-secondary-foreground">
                                        <span>{skill.name}</span>
                                        <span class="text-[10px] text-muted-foreground">
                                            ({skill.level})
                                        </span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
