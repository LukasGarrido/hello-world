---
import Badge from "../ui/Badge.astro";

const education = [
    {
        degree: "Ing. en Informática",
        institution: "Universidad Técnica Federico Santa María",
        period: "2024 – Presente",
        location: "Concepción, Chile",
        status: "En Proceso",
        badgeColor: "indigo" as const,
        type: "Educación Superior",
        icon: "university",
        logo: "usm.png",
        description:
            "Formación orientada al diseño y construcción de software de calidad, modelamiento y administración de bases de datos, algoritmos computacionales y arquitectura de sistemas.",
        skills: [
            {
                name: "Bases de Datos & SQL",
                level: "Medio",
                color: "indigo" as const,
            },
            {
                name: "Desarrollo web Backend",
                level: "En curso",
                color: "slate" as const,
            },
            {
                name: "Data Science",
                level: "En curso",
                color: "slate" as const,
            },
        ],
    },
    {
        degree: "Técnico en Computación e Informática",
        institution: "Centro Educacional Adventista Los Ángeles",
        period: "Graduado",
        location: "Los Ángeles, Chile",
        status: "Titulado",
        badgeColor: "emerald" as const,
        type: "Educación Media Técnico-Profesional",
        icon: "code",
        logo: "Ceala.png",
        description:
            "Formación técnica orientada a soporte y mantenimiento de Hardware y Software, y lógica de desarrollo web.",
        skills: [
            {
                name: "Lógica de Programación & Web",
                level: "Medio",
                color: "emerald" as const,
            },
            {
                name: "Mantenimiento & Hardware",
                level: "Medio",
                color: "emerald" as const,
            },
        ],
    },
];
---

<section
    id="formacion"
    class="min-h-screen min-h-[100dvh] flex flex-col justify-center border-y border-slate-200"
>
    <div class="mx-auto w-full max-w-6xl px-6 py-24">
        <div
            class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
        >
            <div>
                <p
                    class="text-xs font-medium uppercase tracking-wide text-indigo-600"
                >
                    Trayectoria académica
                </p>
                <h2
                    class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
                >
                    Educación & Formación
                </h2>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-slate-500">
                Bases académicas y especialización técnica que respaldan mi
                perfil como desarrollador, combinando rigor conceptual y
                aplicación práctica.
            </p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
            {
                education.map((item) => (
                    <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)] sm:p-7">
                        <div>
                            <div class="flex items-start justify-between gap-4">
                                <img
                                    src={`/${item.logo}`}
                                    alt={item.institution}
                                    class="h-11 w-11 shrink-0 object-contain"
                                />
                                <Badge color={item.badgeColor}>
                                    {item.status}
                                </Badge>
                            </div>

                            <div class="mt-4">
                                <span class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                    {item.type}
                                </span>
                                <h3 class="mt-1 text-xl font-bold tracking-tight text-slate-900">
                                    {item.degree}
                                </h3>
                                <p class="mt-1 text-sm font-medium text-slate-700">
                                    {item.institution}
                                </p>
                                <p class="mt-0.5 text-xs text-slate-400">
                                    {item.location} · {item.period}
                                </p>
                                <p class="mt-3 text-sm leading-relaxed text-slate-500">
                                    {item.description}
                                </p>
                            </div>

                            <div class="mt-6 border-t border-slate-100 pt-5">
                                <p class="text-xs font-medium uppercase tracking-wide text-indigo-600">
                                    Competencias & Áreas Clave
                                </p>
                                <ul class="mt-3 space-y-2.5">
                                    {item.skills.map((skill) => (
                                        <li class="flex items-center justify-between gap-3 text-sm">
                                            <span class="text-slate-600">
                                                {skill.name}
                                            </span>
                                            <Badge color={skill.color}>
                                                {skill.level}
                                            </Badge>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
