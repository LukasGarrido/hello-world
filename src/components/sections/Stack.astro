---
/* src/components/sections/Stack.astro */

const stackItems = [
  { name: "Python", icon: "/public/stack/python.svg" },
  { name: "FastAPI", icon: "/public/stack/fastapi.svg" },
  { name: "Laravel", icon: "/public/stack/laravel.svg" },
  { name: "MySQL", icon: "/public/stack/mysql-icon-light.svg" },
  { name: "SQL Server", icon: "/public/stack/sql-server.svg" },
  { name: "Astro", icon: "/public/stack/astro-icon-light.svg" },
  { name: "Tailwind CSS", icon: "/public/stack/tailwindcss.svg" },
  { name: "Docker", icon: "/public/stack/docker.svg" },
  { name: "Git", icon: "/public/stack/git.svg" },
  { name: "Pandas", icon: "/public/stack/pandas.svg" },
  { name: "NumPy", icon: "/public/stack/numpy.svg" },
  { name: "Bootstrap", icon: "/public/stack/bootstrap.svg" },
  { name: "Antigravity IDE", icon: "/public/stack/antigravity.svg" },
  { name: "Obsidian", icon: "/public/stack/obsidian.svg" },
  { name: "Trello", icon: "/public/stack/trello.svg" },
];

const marqueeItems = [
  ...stackItems.map((item) => ({ ...item, hidden: false })),
  ...stackItems.map((item) => ({ ...item, hidden: true })),
];
---

<section
  id="stack"
  class="relative w-full overflow-x-clip py-16 fade-on-scroll"
>
  <div class="wrapper mb-10 text-center">
    <h2
      class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl"
    >
      Stack & Herramientas
    </h2>
  </div>

  <div class="marquee-container overflow-visible pt-10 pb-4">
    <div class="marquee-track">
      {
        marqueeItems.map((item) => (
          <div
            class="group relative flex h-20 w-20 sm:h-24 sm:w-24 shrink-0 items-center justify-center rounded-[24px] bg-[#fbf9f5] border border-black/5 shadow-sm transition-all duration-300 hover:scale-105 hover:bg-[#f4efe6] select-none cursor-pointer p-4"
            aria-hidden={item.hidden ? "true" : undefined}
          >
            <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-[#fbf9f5] text-foreground border border-black/10 dark:bg-[#1c1c1f] dark:text-white dark:border-white/10 px-2.5 py-1 text-[10px] font-semibold opacity-0 shadow-sm transition-all duration-200 group-hover:opacity-100 group-hover:-translate-y-1 z-20">
              {item.name}
            </span>

            <img
              src={item.icon}
              alt={item.hidden ? "" : `Logo de ${item.name}`}
              class="h-8 w-8 sm:h-10 sm:w-10 object-contain"
              width="40"
              height="40"
              loading="eager"
              decoding="async"
              draggable="false"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
