---
/* src/components/Stack.astro */

const stackGroups = [
  {
    title: "Frontend & UI",
    items: [
      { name: "Astro", description: "Desarrollo enfocado en rendimiento, SSG/SSR y entrega de JS cero por defecto." },
      { name: "Bootstrap", description: "Prototipado ágil y estructuración de interfaces maquetadas con componentes estándar." },
      { name: "Tailwind CSS", description: "Estilizado utility-first optimizado para consistencia de temas y diseño responsivo." },
      { name: "HTMX", description: "Interactividad dinámica en servidor utilizando atributos extendidos de HTML." },
    ],
  },
  {
    title: "Backend & Datos",
    items: [
      { name: "PHP & MySQL", description: "Construcción de APIs, procesamiento en servidor y gestión de bases de datos relacionales." },
      { name: "Python & FastAPI", description: "Desarrollo de servicios de alto rendimiento, modelos de datos asíncronos y scripts de analítica." },
      { name: "PostgreSQL & Redis", description: "Consultas avanzadas, persistencia estructurada y cacheo en memoria para optimizar lecturas." },
    ],
  },
  {
    title: "DevOps & Cloud",
    items: [
      { name: "Docker / Contenedores", description: "Aislamiento de entornos de desarrollo, creación de imágenes y orquestación liviana." },
      { name: "Git", description: "Control de versiones, flujo de ramas estructurado y colaboración en proyectos." },
    ],
  },
];
---

<section id="stack" class="section-full bg-background fade-on-scroll">
  <div class="wrapper">
    <div class="section-head">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        Especialización técnica
      </span>
      <h2 class="mt-1 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Stack & Ecosistema
      </h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
        Herramientas seleccionadas por su robustez operativa, velocidad de cómputo y garantía de tipos.
      </p>
    </div>

    <!-- Grilla Rotativa Interactiva -->
    <div class="grid gap-6 md:grid-cols-3">
      {
        stackGroups.map((group, groupIdx) => (
          <article 
            class="stack-card flex flex-col justify-between rounded-xl border border-border bg-card p-6 shadow-sm transition-colors hover:border-foreground/20"
            data-group-index={groupIdx}
          >
            <div>
              <h3 class="font-display text-base font-bold text-foreground">
                {group.title}
              </h3>

              <div class="mt-4 space-y-2.5">
                {group.items.map((item, itemIdx) => (
                  <div 
                    class="stack-item group/item cursor-pointer overflow-hidden rounded-lg border border-border/40 bg-muted/20 p-3 transition-all duration-300"
                    data-item-index={itemIdx}
                  >
                    <!-- Solo el Nombre de la Tecnología -->
                    <div class="flex items-center justify-between gap-3 text-sm">
                      <span class="font-medium text-foreground/90 group-hover/item:text-foreground">
                        {item.name}
                      </span>
                    </div>

                    <!-- Contenido expandible al rotar -->
                    <div class="stack-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
                      <div class="overflow-hidden">
                        <p class="pt-2 text-xs leading-relaxed text-muted-foreground">
                          {item.description}
                        </p>
                      </div>
                    </div>

                    <!-- Barra de progreso dinámica -->
                    <div class="mt-2.5 h-0.5 w-full overflow-hidden rounded-full bg-border/60">
                      <div class="progress-bar h-full w-0 bg-foreground transition-none"></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupStackRotator() {
    const cards = document.querySelectorAll('.stack-card');
    const DURATION = 4000; // 4 segundos por tecnología

    cards.forEach((card) => {
      const items = card.querySelectorAll('.stack-item');
      if (!items.length) return;

      let currentItem = 0;
      let animationFrame: number;
      let startTime: number | null = null;

      function setActiveItem(index: number) {
        currentItem = index;
        items.forEach((item, i) => {
          const content = item.querySelector('.stack-content') as HTMLElement;
          const bar = item.querySelector('.progress-bar') as HTMLElement;

          if (i === index) {
            item.classList.add('border-foreground/30', 'bg-muted/60');
            if (content) content.style.gridTemplateRows = '1fr';
          } else {
            item.classList.remove('border-foreground/30', 'bg-muted/60');
            if (content) content.style.gridTemplateRows = '0fr';
            if (bar) bar.style.width = '0%';
          }
        });

        startTime = performance.now();
        cancelAnimationFrame(animationFrame);
        animationFrame = requestAnimationFrame(animate);
      }

      function animate(timestamp: number) {
        if (!startTime) startTime = timestamp;
        const elapsed = timestamp - startTime;
        const progress = Math.min((elapsed / DURATION) * 100, 100);

        const currentBar = items[currentItem]?.querySelector('.progress-bar') as HTMLElement;
        if (currentBar) {
          currentBar.style.width = `${progress}%`;
        }

        if (elapsed < DURATION) {
          animationFrame = requestAnimationFrame(animate);
        } else {
          setActiveItem((currentItem + 1) % items.length);
        }
      }

      items.forEach((item, i) => {
        item.addEventListener('click', () => {
          setActiveItem(i);
        });
      });

      setActiveItem(0);
    });
  }

  document.addEventListener('astro:page-load', setupStackRotator);
  setupStackRotator();
</script>