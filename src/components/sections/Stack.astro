---
// src/components/sections/Stack.astro
const stackItems = [
  { name: "Python", role: "Lenguaje principal", icon: "/Stack/python.svg" },
  { name: "FastAPI", role: "Framework de APIs", icon: "/Stack/fastapi.svg" },
  { name: "Pandas", role: "Análisis de datos", icon: "/Stack/Pandas.svg" },
  { name: "NumPy", role: "Cálculo numérico", icon: "/Stack/numpy.svg" },
  { name: "Laravel", role: "Framework PHP", icon: "/Stack/laravel.svg" },
  { name: "Astro", role: "Framework web", icon: "/Stack/astro-icon-light.svg" },
  {
    name: "Tailwind CSS",
    role: "Framework de estilos",
    icon: "/Stack/tailwindcss.svg",
  },
  {
    name: "Bootstrap",
    role: "Framework de estilos",
    icon: "/Stack/bootstrap.svg",
  },
  { name: "MySQL", role: "Base de datos", icon: "/Stack/mysql-icon-light.svg" },
  { name: "SQL Server", role: "Base de datos", icon: "/Stack/sql-server.svg" },
  { name: "Docker", role: "Contenedores", icon: "/Stack/docker.svg" },
  { name: "Git", role: "Control de versiones", icon: "/Stack/git.svg" },
  { name: "GitHub", role: "Repositorios", icon: "/Stack/github_light.svg" },
  { name: "Postman", role: "Pruebas de API", icon: "/Stack/postman.svg" },
  {
    name: "Antigravity IDE",
    role: "Editor de código",
    icon: "/Stack/antigravity.svg",
  },
  { name: "Obsidian", role: "Documentación", icon: "/Stack/obsidian.svg" },
  { name: "Notion", role: "Productividad", icon: "/Stack/notion.svg" },
  { name: "Trello", role: "Gestión de tareas", icon: "/Stack/trello.svg" },
];
---

<section id="stack" class="fade-on-scroll">
  <h2 class="section-title">
    Mi
    <span class="block text-foreground/15">Stack</span>
  </h2>

  <ul class="mt-8 grid grid-cols-1 gap-x-8 gap-y-8 p-4 sm:grid-cols-2">
    {
      stackItems.map((item) => (
        <li class="flex items-center gap-4">
          <div class="flex h-[60px] w-[60px] shrink-0 items-center justify-center rounded-[14px] bg-white">
            <img
              src={item.icon}
              alt=""
              class="h-8 w-8 object-contain"
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="min-w-0">
            <h3 class="font-display text-xl font-semibold leading-tight text-foreground">
              {item.name}
            </h3>
            <p class="text-base text-muted-foreground">{item.role}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
