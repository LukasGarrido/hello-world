---
/* src/components/Contact.astro */
---

<section
    id="contacto"
    class="section-full relative overflow-hidden justify-center fade-on-scroll"
>
    <!-- Fondo Pixel Art decorativo integrado igual que en el Hero -->
    <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-10 dark:opacity-20 mix-blend-multiply dark:mix-blend-screen"
    >
        <img
            src="/Google's DinosaurContact.png"
            alt=""
            aria-hidden="true"
            class="h-full w-full object-cover object-center select-none"
        />
    </div>

    <!-- Contenido del CTA (sobre la capa de fondo) -->
    <div class="wrapper relative z-10">
        <div
            class="flex flex-col items-start justify-between gap-8 py-12 sm:flex-row sm:items-center"
        >
            <div class="max-w-2xl">
                <span
                    class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                    Contacto &amp; Colaboración
                </span>
                <h2
                    class="mt-2 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
                >
                    ¿Tienes un proyecto en mente? Llevémoslo a producción.
                </h2>
                <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                    Abierto a roles de desarrollo (frontend/backend) y data
                    science. Motivado por construir sistemas interesantes,
                    explorar analítica de datos y crecer en el ecosistema
                    tecnológico.
                </p>
            </div>

            <div class="flex w-full shrink-0 sm:w-auto">
                <a
                    href="mailto:contacto@lukasgarrido.dev"
                    class="inline-flex w-full items-center justify-center rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 sm:w-auto shadow-sm"
                >
                    Enviar Correo
                </a>
            </div>
        </div>
    </div>
</section>
