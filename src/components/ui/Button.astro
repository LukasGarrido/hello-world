---
// src/components/ui/Button.astro
export interface Props {
    href?: string;
    variant?: "solid" | "outline" | "ghost" | "brand" | "none";
    size?: "sm" | "md" | "lg";
    type?: "button" | "submit" | "reset";
    class?: string;
    target?: string;
    rel?: string;
    [key: string]: any;
}

const {
    href,
    variant = "solid",
    size = "md",
    type = "button",
    class: className = "",
    target,
    rel,
    ...rest
} = Astro.props;

// Forma basada en Footer.astro: rounded-[5px], font-bold, hover:-translate-y-0.5, active:scale-95
const base =
    "inline-flex items-center justify-center gap-2 rounded-[5px] font-bold transition-all duration-200 hover:-translate-y-0.5 active:scale-95 disabled:opacity-60 disabled:pointer-events-none disabled:transform-none cursor-pointer";

const variants: Record<string, string> = {
    solid: "bg-foreground text-background hover:opacity-90",
    brand: "bg-brand text-white hover:opacity-90",
    outline:
        "border border-border bg-card text-foreground hover:bg-muted hover:border-foreground/30",
    ghost: "text-foreground hover:bg-muted",
    none: "",
};

const sizes: Record<string, string> = {
    sm: "px-2.5 py-1 text-xs",
    md: "px-3 py-1.5 text-sm",
    lg: "px-5 py-2.5 text-sm sm:text-base",
};

// Si se pasa una variante o 'none'
const variantClass = variants[variant] ?? "";
const sizeClass = sizes[size] ?? "";

const classes = [base, variantClass, sizeClass, className]
    .filter(Boolean)
    .join(" ");

const isExternal = href?.startsWith("http");
---

{
    href ? (
        <a
            href={href}
            target={target ?? (isExternal ? "_blank" : undefined)}
            rel={rel ?? (isExternal ? "noopener noreferrer" : undefined)}
            class={classes}
            {...rest}
        >
            <slot />
        </a>
    ) : (
        <button type={type} class={classes} {...rest}>
            <slot />
        </button>
    )
}
