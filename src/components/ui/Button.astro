---
// src/components/ui/Button.astro
export interface Props {
    href?: string;
    variant?: "solid" | "outline" | "ghost";
    size?: "sm" | "md" | "lg";
    type?: "button" | "submit" | "reset";
    class?: string;
    target?: string;
    rel?: string;
}

const {
    href,
    variant = "solid",
    size = "md",
    type = "button",
    class: className = "",
    target,
    rel,
    ...rest
} = Astro.props;

const base =
    "inline-flex items-center justify-center gap-2 rounded-lg font-medium transition-colors whitespace-nowrap disabled:opacity-50 disabled:pointer-events-none";

const variants: Record<string, string> = {
    solid: "bg-primary text-primary-foreground hover:bg-primary/90",
    outline:
        "border border-border bg-card text-foreground hover:border-foreground/30 hover:bg-accent",
    ghost: "text-foreground hover:bg-accent",
};

const sizes: Record<string, string> = {
    sm: "px-3 py-2 text-xs",
    md: "px-4 py-2.5 text-sm",
    lg: "px-5 py-3 text-base",
};

const classes = [base, variants[variant], sizes[size], className]
    .filter(Boolean)
    .join(" ");

const isExternal = href?.startsWith("http");
---

{
    href ? (
        <a
            href={href}
            target={target ?? (isExternal ? "_blank" : undefined)}
            rel={rel ?? (isExternal ? "noopener noreferrer" : undefined)}
            class={classes}
            {...rest}
        >
            <slot />
        </a>
    ) : (
        <button type={type} class={classes} {...rest}>
            <slot />
        </button>
    )
}
