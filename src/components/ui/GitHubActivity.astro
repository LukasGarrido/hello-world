---
// src/components/GitHubActivity.astro
interface Props {
    username: string;
}

const { username } = Astro.props;

const token = import.meta.env.GITHUB_TOKEN;
const ghHeaders: HeadersInit = token
    ? { Authorization: `Bearer ${token}`, "User-Agent": username }
    : { "User-Agent": username };

const languageColors: Record<string, string> = {
    TypeScript: "#3178c6",
    JavaScript: "#f1e05a",
    Python: "#3572A5",
    HTML: "#e34c26",
    CSS: "#563d7c",
    Astro: "#ff5a03",
    Kotlin: "#A97BFF",
    Java: "#b07219",
    Go: "#00ADD8",
    Rust: "#dea584",
    "C++": "#f34b7d",
    "C#": "#178600",
    PHP: "#4F5D95",
    Ruby: "#701516",
    Shell: "#89e051",
    "Jupyter Notebook": "#DA5B0B",
    Vue: "#41b883",
    Dart: "#00B4AB",
};

function langColor(lang: string | null) {
    return lang
        ? (languageColors[lang] ?? "var(--color-muted-foreground)")
        : "var(--color-muted-foreground)";
}

function timeAgo(dateStr: string) {
    const diffMs = Date.now() - new Date(dateStr).getTime();
    const minutes = Math.floor(diffMs / 60000);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    const weeks = Math.floor(days / 7);
    const months = Math.floor(days / 30);

    if (minutes < 60) return `hace ${minutes} min.`;
    if (hours < 24) return `hace ${hours} h.`;
    if (days < 7) return `hace ${days} día${days === 1 ? "" : "s"}.`;
    if (weeks < 5) return `hace ${weeks} sem.`;
    return `hace ${months} mes${months === 1 ? "" : "es"}.`;
}

const [profileRes, reposRes, eventsRes, contribRes] = await Promise.allSettled([
    fetch(`https://api.github.com/users/${username}`, { headers: ghHeaders }),
    fetch(
        `https://api.github.com/users/${username}/repos?sort=pushed&per_page=100`,
        { headers: ghHeaders },
    ),
    fetch(`https://api.github.com/users/${username}/events/public`, {
        headers: ghHeaders,
    }),
    fetch(`https://github-contributions-api.jogruber.de/v4/${username}?y=last`),
]);

const profile =
    profileRes.status === "fulfilled" && profileRes.value.ok
        ? await profileRes.value.json()
        : null;

const allRepos =
    reposRes.status === "fulfilled" && reposRes.value.ok
        ? await reposRes.value.json()
        : [];

const featuredRepos = allRepos
    .filter((repo: any) => !repo.fork)
    .sort(
        (a: any, b: any) =>
            new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime(),
    )
    .slice(0, 4);

const events =
    eventsRes.status === "fulfilled" && eventsRes.value.ok
        ? await eventsRes.value.json()
        : [];

const lastPush = events.find((e: any) => e.type === "PushEvent");

const contribData =
    contribRes.status === "fulfilled" && contribRes.value.ok
        ? await contribRes.value.json()
        : null;

// Total de contribuciones / commits del último año
const totalCommits =
    contribData?.total?.[String(new Date().getFullYear())] ??
    contribData?.contributions?.reduce(
        (sum: number, day: any) => sum + day.count,
        0,
    ) ??
    "—";
---

<section id="github" class="section-full bg-background fade-on-scroll">
    <div class="wrapper">
        <div
            class="rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8"
        >
            <!-- Header del perfil -->
            <div
                class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
            >
                <div>
                    <span
                        class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                    >
                        Ecosistema Dev
                    </span>
                    <div class="mt-2 flex items-center gap-3">
                        <img
                            src={profile?.avatar_url ??
                                `https://github.com/${username}.png`}
                            alt={username}
                            class="h-10 w-10 rounded-full border border-border object-cover"
                        />
                        <h2
                            class="font-display text-2xl font-bold tracking-tight text-foreground"
                        >
                            @{username}
                        </h2>
                    </div>
                </div>

                <a
                    href={`https://github.com/${username}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-md bg-secondary/80 px-3 py-1.5 text-xs font-medium text-secondary-foreground transition-opacity hover:opacity-90"
                >
                    Ver perfil en GitHub
                    <svg
                        class="h-3.5 w-3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        ></path>
                    </svg>
                </a>
            </div>

            <!-- Gráfico de Contribuciones Dinámico -->
            <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
                <div class="overflow-x-auto lg:col-span-2">
                    <div
                        class="mb-3 flex items-center justify-between text-xs text-muted-foreground"
                    >
                        <span>Registro de actividad en el último año</span>
                    </div>

                    <div class="py-1">
                        <img
                            src={`https://ghchart.rshah.org/404040/${username}`}
                            alt={`Gráfico de actividad de GitHub para ${username}`}
                            class="w-full min-w-[650px] object-contain opacity-80 transition-opacity hover:opacity-100 dark:invert dark:hue-rotate-180"
                            loading="lazy"
                        />
                    </div>
                </div>

                <!-- Última Actividad -->
                <div class="flex flex-col gap-2">
                    <span
                        class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                    >
                        Actividad reciente
                    </span>

                    {
                        lastPush ? (
                            <div class="rounded-lg border border-border/60 bg-muted/30 p-3.5">
                                <p class="text-xs font-bold text-foreground">
                                    Push al repositorio
                                </p>
                                <p class="mt-1 flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <span class="h-2 w-2 rounded-full bg-emerald-500" />
                                    {username} · {timeAgo(lastPush.created_at)}
                                </p>
                            </div>
                        ) : (
                            <div class="rounded-lg border border-border/60 bg-muted/30 p-3.5">
                                <p class="text-xs text-muted-foreground">
                                    Sin actividad pública reciente.
                                </p>
                            </div>
                        )
                    }
                </div>
            </div>

            <!-- Métricas rápidas: Cambiado Seguidores por Commits -->
            <div
                class="mt-6 grid grid-cols-2 gap-4 border-t border-border/50 pt-6 sm:grid-cols-2"
            >
                <div class="rounded-lg bg-secondary/30 p-3">
                    <p class="font-display text-lg font-bold text-foreground">
                        {totalCommits}
                    </p>
                    <p class="mt-0.5 text-[11px] text-muted-foreground">
                        Commits (Último año)
                    </p>
                </div>
                <div class="rounded-lg bg-secondary/30 p-3">
                    <p class="font-display text-lg font-bold text-foreground">
                        {profile?.public_repos ?? "—"}
                    </p>
                    <p class="mt-0.5 text-[11px] text-muted-foreground">
                        Repositorios públicos
                    </p>
                </div>
            </div>

            <!-- Repositorios destacados -->
            <div class="mt-6 border-t border-border/50 pt-6">
                <p
                    class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                    Repositorios recientes
                </p>

                {
                    featuredRepos.length > 0 ? (
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            {featuredRepos.map((repo: any) => (
                                <a
                                    href={repo.html_url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="flex flex-col justify-between gap-3 rounded-lg border border-border/60 bg-muted/20 p-4 transition-colors hover:border-foreground/30 hover:bg-muted/40"
                                >
                                    <div>
                                        <div class="flex items-start justify-between gap-2">
                                            <h3 class="font-display text-sm font-bold text-foreground">
                                                {repo.name}
                                            </h3>
                                            {repo.stargazers_count > 0 && (
                                                <span class="flex shrink-0 items-center gap-1 text-xs font-medium text-foreground/80">
                                                    <svg
                                                        class="h-3 w-3"
                                                        fill="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                    </svg>
                                                    {repo.stargazers_count}
                                                </span>
                                            )}
                                        </div>
                                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                            {repo.description ??
                                                "Sin descripción disponible."}
                                        </p>
                                    </div>

                                    {repo.language && (
                                        <span class="inline-flex w-fit items-center gap-1.5 rounded bg-secondary/80 px-2 py-0.5 text-[10px] font-medium text-secondary-foreground">
                                            <span
                                                class="h-2 w-2 rounded-full"
                                                style={`background-color:${langColor(repo.language)}`}
                                            />
                                            {repo.language}
                                        </span>
                                    )}
                                </a>
                            ))}
                        </div>
                    ) : (
                        <p class="text-xs text-muted-foreground">
                            No se encontraron repositorios públicos.
                        </p>
                    )
                }
            </div>
        </div>
    </div>
</section>
