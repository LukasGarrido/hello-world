---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lukas Garrido — Portfolio",
  description = "Portfolio personal de desarrollador Backend y Data Science.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>

  <body class="bg-background text-foreground font-sans min-h-screen">
    <div
      id="splash-screen"
      class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-background transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] select-none pointer-events-auto"
    >
      <div
        class="absolute h-64 w-64 rounded-full bg-brand/15 blur-[100px] pointer-events-none animate-pulse"
      >
      </div>

      <div class="relative z-10 flex flex-col items-center gap-6">
        <div class="overflow-hidden py-2 px-4">
          <h1
            class="splash-title font-display text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-foreground"
          >
            Lukas Garrido<span class="text-brand inline-block animate-bounce"
              >.</span
            >
          </h1>
        </div>

        <p
          class="splash-subtitle text-xs sm:text-sm font-medium text-muted-foreground/80 tracking-widest uppercase"
        >
          Software & Data Engineer
        </p>

        <div
          class="mt-2 h-[2px] w-36 overflow-hidden rounded-full bg-border/40"
        >
          <div
            class="splash-bar h-full w-full bg-foreground rounded-full origin-left"
          >
          </div>
        </div>
      </div>
    </div>

    <slot />

    <script is:inline>
      (function () {
        const splash = document.getElementById("splash-screen");
        if (!splash) return;

        const hasVisited = sessionStorage.getItem("portfolio_splash_shown");

        if (hasVisited) {
          splash.remove();
        } else {
          document.body.style.overflow = "hidden";

          setTimeout(() => {
            splash.style.opacity = "0";
            splash.style.transform = "translateY(-12px) scale(0.98)";
            splash.style.pointerEvents = "none";
            document.body.style.overflow = "";

            setTimeout(() => {
              splash.remove();
              sessionStorage.setItem("portfolio_splash_shown", "true");
            }, 700);
          }, 1800);
        }
      })();
    </script>

    <script>
      function setupScrollObserver() {
        const sections = document.querySelectorAll(".fade-on-scroll");
        if (!sections.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.classList.toggle("is-visible", entry.isIntersecting);
            });
          },
          {
            threshold: 0.15,
            rootMargin: "0px 0px -10% 0px",
          },
        );

        sections.forEach((section) => observer.observe(section));
      }

      document.addEventListener("astro:page-load", setupScrollObserver);
      setupScrollObserver();
    </script>
  </body>
</html>
