---
/* src/pages/proyectos/[id].astro */
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ProjectHero from "../../components/project-detail/ProjectHero.astro";
import ProjectContent from "../../components/project-detail/ProjectContent.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;

// Renderiza el contenido estandarizado del archivo .md
const { Content } = await render(project);

// Imagen de fondo para el hero o fallback por defecto
const bgImage = data.backgroundImg ?? "/Google's Dinosaur2.png";
---

<Layout title={`${data.title} — Caso de Estudio`}>
    <Header />

    <main class="relative overflow-hidden justify-center py-12 md:py-16">
        <article class="wrapper relative z-10 max-w-4xl">
            <!-- Botón Volver -->
            <a
                href="/#proyectos"
                class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors mb-8"
            >
                <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
                Volver a proyectos
            </a>

            <!-- Header / Hero del Proyecto -->
            <ProjectHero
                title={data.title}
                description={data.description}
                category={data.category}
                tag={data.tag}
                tags={data.tags}
                backgroundImg={bgImage}
                links={data.links}
            />

            <!-- Secciones detalladas (Renderizadas desde el .md) -->
            <ProjectContent>
                <Content />
            </ProjectContent>
        </article>
    </main>

    <Footer />
</Layout>
