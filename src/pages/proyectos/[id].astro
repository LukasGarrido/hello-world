---
// src/pages/proyectos/[id].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import ProfileCard from "../../components/layout/ProfileCard.astro";
import Footer from "../../components/layout/Footer.astro";
import Button from "../../components/ui/Button.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const heroImage =
    data.heroImage ?? data.backgroundImg ?? "/images/LevelWorksHero.png";

/* Estilos del Markdown renderizado (sin depender de @tailwindcss/typography) */
const markdownClass = [
    "[&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-foreground",
    "[&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-foreground",
    "[&_p]:mb-4 [&_p]:text-base [&_p]:leading-relaxed [&_p]:text-muted-foreground sm:[&_p]:text-lg",
    "[&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6",
    "[&_li]:mb-1.5 [&_li]:text-base [&_li]:text-muted-foreground sm:[&_li]:text-lg",
    "[&_a]:text-brand [&_a]:underline [&_a]:underline-offset-4",
    "[&_strong]:font-semibold [&_strong]:text-foreground",
    "[&_blockquote]:my-6 [&_blockquote]:border-l-2 [&_blockquote]:border-brand [&_blockquote]:pl-4 [&_blockquote]:text-muted-foreground",
    "[&_code]:rounded [&_code]:bg-muted [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-sm [&_code]:text-foreground",
    "[&_pre]:mb-6 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:p-4 [&_pre]:text-sm",
    "[&_pre_code]:bg-transparent [&_pre_code]:p-0",
    "[&_img]:my-6 [&_img]:rounded-xl",
    "[&_hr]:my-10 [&_hr]:border-border",
].join(" ");
---

<Layout title={`${data.title} — Caso de Estudio`}>
    <Header />

    <div
        class="mx-auto grid max-w-[1140px] grid-cols-1 gap-10 px-4 pt-24 pb-16
           lg:grid-cols-[344px_minmax(0,1fr)] lg:gap-x-[100px] lg:pt-[120px]"
    >
        <aside
            class="flex justify-center lg:sticky lg:top-24 lg:justify-start lg:self-start"
        >
            <ProfileCard />
        </aside>

        <main class="min-w-0">
            <article class="flex flex-col gap-10">
                <!-- Volver -->
                <Button
                    href="/#proyectos"
                    variant="outline"
                    class="w-fit"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                    </svg>
                    <span>Volver a proyectos</span>
                </Button>

                <!-- Cabecera -->
                <header class="flex flex-col gap-5">
                    <p class="text-sm uppercase tracking-widest text-brand">
                        {data.category}
                    </p>

                    <h1 class="section-title">{data.title}</h1>

                    <p
                        class="max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg"
                    >
                        {data.description}
                    </p>

                    {
                        data.tags && data.tags.length > 0 && (
                            <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                                {data.tags.map((tag: string) => (
                                    <li class="rounded-md bg-muted px-2.5 py-1 text-sm text-foreground/80">
                                        {tag}
                                    </li>
                                ))}
                            </ul>
                        )
                    }

                    {
                        data.links && data.links.length > 0 && (
                            <div class="flex flex-wrap items-center gap-3 pt-1">
                                {data.links.map((link) => (
                                    <Button
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        variant={link.variant === "solid" ? "solid" : "outline"}
                                    >
                                        <span>{link.label}</span>
                                        <svg
                                            class="h-4 w-4"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            aria-hidden="true"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M7 17L17 7M8 7h9v9"
                                            />
                                        </svg>
                                    </Button>
                                ))}
                            </div>
                        )
                    }
                </header>

                <!-- Imagen principal -->
                {
                    heroImage && (
                        <img
                            src={heroImage}
                            alt={`Previsualización de ${data.title}`}
                            class="w-full rounded-xl object-cover object-top"
                            loading="eager"
                        />
                    )
                }

                <!-- Contenido del .md -->
                <div class={markdownClass}>
                    <Content />
                </div>
            </article>
        </main>
    </div>

    <Footer />
</Layout>
