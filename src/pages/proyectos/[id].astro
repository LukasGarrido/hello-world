---
/* src/pages/proyectos/[id].astro */
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Badge from "../../components/ui/Badge.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;

const { Content } = await render(project);

const heroImage =
    data.heroImage ?? data.backgroundImg ?? "/images/LevelWorksHero.png";
---

<Layout title={`${data.title} — Caso de Estudio`}>
    <Header />

    <main class="relative overflow-hidden py-24 md:py-32">
        <article class="wrapper relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
            <a
                href="/#proyectos"
                class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-muted/40 px-4 py-2 text-xs font-semibold text-muted-foreground transition-all duration-200 hover:bg-muted hover:text-foreground hover:border-foreground/30 shadow-sm mb-10"
            >
                <svg
                    class="h-3.5 w-3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                </svg>
                <span>Volver a proyectos</span>
            </a>

            <!-- Header / Hero del Proyecto -->
            <div class="flex flex-col gap-6">
                <h1
                    class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-foreground"
                >
                    {data.title}
                </h1>

                <p
                    class="text-base sm:text-lg leading-relaxed text-muted-foreground"
                >
                    {data.description}
                </p>

                <!-- Tags del Proyecto -->
                {
                    data.tags && (
                        <div class="flex flex-wrap gap-1.5 pt-1">
                            {data.tags.map((tag: string) => (
                                <span class="rounded-md bg-muted/60 px-2.5 py-1 text-xs font-medium text-foreground/80">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )
                }

                <!-- Enlaces de Acción (Demo, GitHub, etc.) -->
                {
                    data.links && data.links.length > 0 && (
                        <div class="flex flex-wrap items-center gap-3 pt-2">
                            {data.links.map(
                                (link: {
                                    href: string;
                                    variant: string;
                                    label: string;
                                }) => (
                                    <a
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class:list={[
                                            "inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold transition-all duration-200 shadow-sm",
                                            link.variant === "solid"
                                                ? "bg-foreground text-background hover:opacity-90"
                                                : "border border-border bg-card/80 text-foreground hover:bg-muted hover:border-foreground/30",
                                        ]}
                                    >
                                        <span>{link.label}</span>
                                        <svg
                                            class="h-3.5 w-3.5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                                            />
                                        </svg>
                                    </a>
                                ),
                            )}
                        </div>
                    )
                }
            </div>

            <!-- Imagen Principal / Mockup del Proyecto -->
            {
                heroImage && (
                    <div class="mt-10 relative h-72 sm:h-96 w-full overflow-hidden rounded-3xl border border-border/60 bg-muted/50 shadow-md">
                        <img
                            src={heroImage}
                            alt={`Previsualización detallada de ${data.title}`}
                            class="h-full w-full object-cover object-center"
                        />
                    </div>
                )
            }

            <!-- Contenido Detallado Renderizado desde el archivo .md -->
            <div
                class="mt-14 rounded-3xl border border-border/60 bg-muted/20 dark:bg-card/30 p-6 sm:p-10 shadow-sm"
            >
                <div
                    class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-display prose-headings:font-bold prose-a:text-brand prose-img:rounded-2xl"
                >
                    <Content />
                </div>
            </div>
        </article>
    </main>

    <Footer />
</Layout>
