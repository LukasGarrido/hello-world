---
/* src/pages/proyectos/[id].astro */
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;

// Renderiza el contenido estandarizado del archivo .md
const { Content } = await render(project);

// Imagen de fondo para el hero o fallback por defecto
const bgImage = data.backgroundImg ?? "/Google's Dinosaur2.png";
---

<Layout title={`${data.title} — Caso de Estudio`}>
    <Header />

    <main
        class="relative overflow-hidden justify-center py-12 md:py-16 fade-on-scroll"
    >
        <article class="wrapper relative z-10 max-w-4xl">
            <!-- Botón Volver -->
            <a
                href="/#proyectos"
                class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors mb-8"
            >
                <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
                Volver a proyectos
            </a>

            <!-- Header / Hero del Proyecto con Imagen Pixel Art -->
            <header
                class="relative overflow-hidden rounded-xl border border-border/80 bg-card/40 backdrop-blur-md p-6 sm:p-10 shadow-sm"
            >
                <!-- Capa de Imagen de fondo con blend mode -->
                <div
                    class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-15 dark:opacity-25 mix-blend-multiply dark:mix-blend-screen"
                >
                    <img
                        src={bgImage}
                        alt=""
                        aria-hidden="true"
                        class="h-full w-full object-cover object-center select-none"
                    />
                </div>

                <div class="relative z-10">
                    <span
                        class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                    >
                        {data.category} · {data.tag}
                    </span>

                    <h1
                        class="mt-2 font-display text-3xl font-bold tracking-tight text-foreground sm:text-5xl"
                    >
                        {data.title}
                    </h1>

                    <p
                        class="mt-4 text-base sm:text-lg leading-relaxed text-muted-foreground"
                    >
                        {data.description}
                    </p>

                    <!-- Tags / Stack principal -->
                    <div class="mt-6 flex flex-wrap gap-2">
                        {
                            data.tags.map((t) => (
                                <span class="rounded-md bg-secondary/80 backdrop-blur-sm px-2.5 py-1 text-xs font-medium text-secondary-foreground">
                                    {t}
                                </span>
                            ))
                        }
                    </div>

                    <!-- Botones de Enlaces Externos -->
                    {
                        data.links && data.links.length > 0 && (
                            <div class="mt-8 flex flex-wrap gap-3 border-t border-border/40 pt-6">
                                {data.links.map((link) => (
                                    <a
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class={
                                            link.variant === "solid"
                                                ? "inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground hover:opacity-90 transition-opacity shadow-sm"
                                                : "inline-flex items-center justify-center rounded-lg border border-border/80 bg-card/80 backdrop-blur-sm px-4 py-2 text-xs font-semibold text-foreground hover:bg-accent transition-colors shadow-sm"
                                        }
                                    >
                                        {link.label}
                                    </a>
                                ))}
                            </div>
                        )
                    }
                </div>
            </header>

            <!-- Secciones detalladas estandarizadas (Renderizadas desde el .md) -->
            <section
                class="mt-8 rounded-xl border border-border/80 bg-card/40 backdrop-blur-md p-6 sm:p-10 shadow-sm"
            >
                <div
                    class="w-full max-w-none text-base md:text-lg text-muted-foreground leading-relaxed
                           [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:text-foreground [&_h1]:mb-6 [&_h1]:mt-10 [&_h1]:font-display
                           [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-foreground [&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:pb-2 [&_h2]:border-b [&_h2]:border-border/60 [&_h2]:font-display
                           [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-foreground [&_h3]:mb-4 [&_h3]:mt-8 [&_h3]:font-display
                           [&_p]:mb-6
                           [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-muted-foreground hover:[&_a]:decoration-foreground [&_a]:transition-colors
                           [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-6 [&_ul>li]:mb-2 [&_ul>li::marker]:text-muted-foreground
                           [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-6 [&_ol>li]:mb-2 [&_ol>li::marker]:text-muted-foreground
                           [&_li>ul]:mt-2 [&_li>ol]:mt-2
                           [&_blockquote]:border-l-4 [&_blockquote]:border-primary/50 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-muted-foreground [&_blockquote]:my-6 [&_blockquote]:bg-muted/20 [&_blockquote]:py-3 [&_blockquote]:pr-4 [&_blockquote]:rounded-r-lg
                           [&_strong]:font-semibold [&_strong]:text-foreground
                           [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded-md [&_:not(pre)>code]:bg-muted/80 [&_:not(pre)>code]:text-foreground [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-sm
                           [&_pre]:p-4 [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-border/50 [&_pre]:overflow-x-auto [&_pre]:my-6 [&_pre]:text-sm [&_pre]:shadow-sm
                           [&_img]:rounded-xl [&_img]:border [&_img]:border-border/50 [&_img]:my-8 [&_img]:shadow-sm
                           [&_table]:w-full [&_table]:mb-6 [&_table]:text-left [&_table]:border-collapse [&_table]:text-sm
                           [&_th]:py-3 [&_th]:px-4 [&_th]:border-b [&_th]:border-border [&_th]:text-foreground [&_th]:font-semibold [&_th]:bg-muted/30
                           [&_td]:py-3 [&_td]:px-4 [&_td]:border-b [&_td]:border-border/50
                           [&_hr]:my-10 [&_hr]:border-border/50"
                >
                    <Content />
                </div>
            </section>
        </article>
    </main>

    <Footer />
</Layout>
