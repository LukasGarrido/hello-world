---
/* src/pages/404.astro */
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<Layout title="404 — Página no encontrada | Lukas Garrido">
    <Header />

    <main
        class="relative flex min-h-[calc(100vh-140px)] flex-col items-center justify-center overflow-hidden px-6 py-16"
    >
        <!-- Canvas Animado de Fondo Absoluto (Olas por toda la sección) -->
        <div
            class="pointer-events-none absolute inset-0 z-0 opacity-60 dark:opacity-80 transition-opacity duration-500 [mask-image:radial-gradient(ellipse_at_center,transparent_10%,black_75%)]"
        >
            <canvas id="waves-canvas" class="h-full w-full"></canvas>
        </div>

        <!-- Resplandor ambiental de marca -->
        <div
            class="pointer-events-none absolute z-0 h-96 w-96 rounded-full bg-brand/10 blur-[140px] transition-all duration-700"
        >
        </div>

        <section
            class="relative z-10 mx-auto max-w-lg text-center flex flex-col items-center"
        >
            <!-- Número 404 Gigante con Tipografía Display -->
            <div class="relative flex items-center justify-center">
                <span
                    class="font-display text-8xl sm:text-9xl font-extrabold tracking-tighter text-foreground/10 dark:text-foreground/5 select-none"
                >
                    404
                </span>
                <span
                    class="absolute font-display text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground"
                >
                    <span class="font-serif italic font-normal text-brand"
                        >Página</span
                    > no encontrada
                </span>
            </div>

            <p
                class="mt-6 text-sm sm:text-base leading-relaxed text-muted-foreground/90 max-w-sm"
            >
                La página que estás buscando no existe o fue movida a otra
                ubicación.
            </p>

            <div class="mt-8">
                <a
                    href="/"
                    class="inline-flex items-center gap-2 rounded-full border border-border/40 bg-card/40 backdrop-blur-md px-6 py-2.5 text-xs font-semibold text-foreground transition-all duration-300 hover:border-foreground/30 hover:bg-muted/50 active:scale-95 shadow-2xs"
                >
                    <svg
                        class="h-4 w-4 text-muted-foreground transition-colors group-hover:text-foreground"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    <span>Volver al Inicio</span>
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<script>
    function initWavesCanvas() {
        const canvas = document.getElementById(
            "waves-canvas",
        ) as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        let width = (canvas.width = canvas.offsetWidth);
        let height = (canvas.height = canvas.offsetHeight);

        let step = 0;

        const handleResize = () => {
            if (!canvas) return;
            width = canvas.width = canvas.offsetWidth;
            height = canvas.height = canvas.offsetHeight;
        };

        window.addEventListener("resize", handleResize);

        function animate() {
            if (!ctx) return;
            ctx.clearRect(0, 0, width, height);

            const isDark = document.documentElement.classList.contains("dark");

            // Colores adaptados a --brand y al esquema de color actual
            const brandWave = isDark
                ? "rgba(59, 130, 246, 0.45)"
                : "rgba(37, 99, 235, 0.35)";
            const secondaryWave = isDark
                ? "rgba(255, 255, 255, 0.08)"
                : "rgba(0, 0, 0, 0.06)";

            step += 0.015;

            function drawWave(
                color: string,
                amplitude: number,
                frequency: number,
                phase: number,
                yOffset: number,
            ) {
                if (!ctx) return;
                ctx.save();
                ctx.beginPath();

                ctx.moveTo(0, height / 2 + yOffset);
                for (let x = 0; x <= width; x += 3) {
                    const y =
                        Math.sin(x * frequency + step + phase) * amplitude +
                        height / 2 +
                        yOffset;
                    ctx.lineTo(x, y);
                }

                ctx.strokeStyle = color;
                ctx.lineWidth = 1.2;
                ctx.stroke();
                ctx.restore();
            }

            // Múltiples olas cruzadas a lo largo de toda la sección
            drawWave(secondaryWave, 28, 0.008, 0, 20);
            drawWave(secondaryWave, 35, 0.005, 2, -30);
            drawWave(brandWave, 24, 0.01, 4, 0);

            requestAnimationFrame(animate);
        }

        animate();
    }

    document.addEventListener("astro:page-load", initWavesCanvas);
    initWavesCanvas();
</script>
