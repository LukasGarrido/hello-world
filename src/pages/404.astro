---
/* src/pages/404.astro */
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<Layout title="404 - Página no encontrada">
    <Header />

    <main
        class="relative flex flex-col items-center justify-center min-h-[calc(100vh-140px)] px-6 py-16 overflow-hidden"
    >
        <section
            class="relative z-10 mx-auto max-w-xl text-center flex flex-col items-center"
        >
            <h1
                class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-foreground"
            >
                <span class="font-serif italic font-normal text-brand"
                    >Page</span
                > not found.
            </h1>

            <p
                class="mt-4 text-sm sm:text-base leading-relaxed text-muted-foreground/90 max-w-md"
            >
                Lo siento, la ruta que estás buscando no existe o ha sido
                movida. Puedes volver al inicio para explorar mis proyectos y
                experiencia.
            </p>

            <div
                class="mt-8 w-full max-w-sm rounded-xl border border-border/60 bg-muted/30 dark:bg-card/40 p-4 font-mono text-xs leading-relaxed text-foreground/90 text-left shadow-sm"
            >
                <p
                    class="text-[11px] font-semibold text-muted-foreground border-b border-border/40 pb-1.5 mb-2"
                >
                    server.log
                </p>
                <p class="text-xs">
                    <span class="text-brand font-semibold">&gt;</span> GET /ruta-desconocida
                    <span class="text-destructive font-semibold"
                        >404 Not Found</span
                    >
                </p>
                <p class="text-xs mt-1">
                    <span class="text-emerald-500 font-semibold">&gt;</span> redirecting_to:
                    "/"
                </p>
            </div>

            <div class="mt-8 flex items-center justify-center">
                <a
                    href="/"
                    class="inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-2.5 text-xs font-semibold text-background transition-all duration-200 hover:opacity-90 active:scale-95 shadow-sm"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    <span>Volver al Inicio</span>
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
