---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<Layout title="404 — Página no encontrada | Lukas Garrido">
    <Header />

    <main
        class="mx-auto flex min-h-[calc(100dvh-9rem)] max-w-[1140px] flex-col justify-center gap-6 px-4 pt-28 pb-10"
    >
        <p class="text-sm uppercase tracking-widest text-brand">Error 404</p>

        <h1 class="hero-title">
            Página
            <span class="block text-foreground/15">no encontrada</span>
        </h1>

        <p
            class="max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
            La página que buscas no existe o fue movida a otra ubicación.
        </p>

        <a
            href="/"
            class="inline-flex w-fit items-center gap-2 rounded-btn bg-foreground px-5 py-2.5 text-sm font-semibold text-background transition-opacity hover:opacity-90"
        >
            <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
            </svg>
            <span>Volver al inicio</span>
        </a>
    </main>

    <Footer />
</Layout>
